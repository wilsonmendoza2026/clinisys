<%
if(session.getAttribute("logueado")==null||"0".equals(String.valueOf(session.getAttribute("logueado")))||session.getAttribute("id_rol")==null){response.setStatus(401);out.print("Sesión no válida o expirada.");return;}
String tipo=request.getParameter("tipo");if(tipo==null)tipo="";
try(Connection conn=DriverManager.getConnection("jdbc:postgresql://localhost:5432/sistema_nutricion","postgres","1")){
 conn.setAutoCommit(false);
 String permiso="ver";if("Modificar".equals(tipo))permiso="editar";else if("Anular".equals(tipo)||"Pagar".equals(tipo))permiso="editar";
 if(!tienePermiso(conn,session.getAttribute("id_rol"),"Gestión de cobros pendientes",permiso)){response.setStatus(403);out.print("No tiene permiso para esta operación.");return;}
 if("listar".equals(tipo)||"reporte_general".equals(tipo)||"reporte_individual".equals(tipo)){cpSincronizar(conn);conn.commit();}
 if("listar".equals(tipo)){
  String paciente=request.getParameter("paciente"),cedula=request.getParameter("cedula"),estado=request.getParameter("estado");
  String sql="SELECT c.id_cobro_pendiente,c.id_paciente,c.concepto,c.monto,c.estado,c.fecha,c.origen_tipo,COALESCE(p.nombre,'') nombre,COALESCE(p.apellido,'') apellido,COALESCE(p.cedula,'') cedula FROM cobros_pendientes c LEFT JOIN pacientes p ON p.id_paciente=c.id_paciente WHERE (?='' OR LOWER(COALESCE(p.nombre,'')||' '||COALESCE(p.apellido,'')) LIKE LOWER(?)) AND (?='' OR COALESCE(p.cedula,'') LIKE ?) AND (?='' OR UPPER(COALESCE(c.estado,''))=UPPER(?)) ORDER BY c.id_cobro_pendiente DESC";
  try(PreparedStatement ps=conn.prepareStatement(sql)){String pn=paciente==null?"":paciente.trim(),cd=cedula==null?"":cedula.trim(),es=estado==null?"":estado.trim();ps.setString(1,pn);ps.setString(2,"%"+pn+"%");ps.setString(3,cd);ps.setString(4,"%"+cd+"%");ps.setString(5,es);ps.setString(6,es);try(ResultSet rs=ps.executeQuery()){while(rs.next()){
   int id=rs.getInt("id_cobro_pendiente");String est=rs.getString("estado");if(est==null)est="Pendiente";String badge="badge-warning";if("PAGADO".equalsIgnoreCase(est)||"COBRADO".equalsIgnoreCase(est))badge="badge-success";else if("ANULADO".equalsIgnoreCase(est))badge="badge-danger";
   String nombre=(rs.getString("apellido")+", "+rs.getString("nombre")).replaceAll("^, |, $","");BigDecimal monto=rs.getBigDecimal("monto");String montoTxt=monto==null?"0.00":monto.toPlainString();String concepto=rs.getString("concepto"),origen=rs.getString("origen_tipo");boolean vinculado=origen!=null&&!origen.trim().isEmpty();
%><tr><td><%=id%><%if(vinculado){%><br><small class="text-muted"><%="CITA".equals(origen)?"Agenda":"Internación"%></small><%}%></td><td><%=cpEsc(nombre)%></td><td><%=cpEsc(rs.getString("cedula"))%></td><td><%=cpEsc(concepto)%></td><td class="text-right"><%=cpEsc(montoTxt)%></td><td><span class="badge <%=badge%>"><%=cpEsc(est)%></span></td><td><%=cpEsc(rs.getString("fecha"))%></td><td class="text-center"><div class="btn-group"><%if(!vinculado&&"Pendiente".equalsIgnoreCase(est)){%><button class="btn btn-sm btn-warning text-white" title="Modificar concepto y monto" onclick="editarCobro('<%=id%>',this.dataset.concepto,this.dataset.monto)" data-concepto="<%=cpEsc(concepto)%>" data-monto="<%=cpEsc(montoTxt)%>"><i class="fas fa-edit"></i></button><%}%><%if("Pendiente".equalsIgnoreCase(est)){%><button class="btn btn-sm btn-success" title="Marcar como pagado" onclick="cambiarEstado('<%=id%>','Pagar')"><i class="fas fa-check"></i></button><%if(!vinculado){%><button class="btn btn-sm btn-danger" title="Anular" onclick="cambiarEstado('<%=id%>','Anular')"><i class="fas fa-ban"></i></button><%}%><%}%><a class="btn btn-sm btn-secondary" title="Reporte individual" target="_blank" href="cobros_pendientescontrolador.jsp?tipo=reporte_individual&pk=<%=id%>"><i class="fas fa-print"></i></a></div></td></tr><%
  }}}
 }else if("Modificar".equals(tipo)){
  String pk=request.getParameter("pk"),concepto=request.getParameter("concepto"),monto=request.getParameter("monto");if(pk==null||concepto==null||concepto.trim().isEmpty()||monto==null)throw new IllegalArgumentException("Complete el concepto y el monto.");BigDecimal valor=new BigDecimal(monto);if(valor.compareTo(BigDecimal.ZERO)<=0)throw new IllegalArgumentException("El monto debe ser mayor que cero.");
  try(PreparedStatement ps=conn.prepareStatement("UPDATE cobros_pendientes SET concepto=?,monto=? WHERE id_cobro_pendiente=? AND origen_tipo IS NULL AND UPPER(COALESCE(estado,'PENDIENTE'))='PENDIENTE'")){ps.setString(1,concepto.trim());ps.setBigDecimal(2,valor);ps.setInt(3,Integer.parseInt(pk));if(ps.executeUpdate()==0)throw new IllegalArgumentException("Solo se pueden modificar cobros directos que sigan pendientes.");}conn.commit();out.print("success");
 }else if("Pagar".equals(tipo)){
  int id=Integer.parseInt(request.getParameter("pk"));String origen=null;int origenId=0;try(PreparedStatement ps=conn.prepareStatement("SELECT origen_tipo,origen_id FROM cobros_pendientes WHERE id_cobro_pendiente=? AND UPPER(COALESCE(estado,'PENDIENTE'))='PENDIENTE' FOR UPDATE")){ps.setInt(1,id);try(ResultSet rs=ps.executeQuery()){if(!rs.next())throw new IllegalArgumentException("No se encontró un cobro pendiente.");origen=rs.getString(1);origenId=rs.getInt(2);}}
  if("CITA".equals(origen)){try(PreparedStatement ps=conn.prepareStatement("UPDATE citas SET estado_pago='COBRADO' WHERE id_cita=?")){ps.setInt(1,origenId);ps.executeUpdate();}}
  else if("INTERNACION".equals(origen)){try(PreparedStatement ps=conn.prepareStatement("UPDATE internaciones SET estado_pago='COBRADO' WHERE id_internacion=?")){ps.setInt(1,origenId);ps.executeUpdate();}}
  try(PreparedStatement ps=conn.prepareStatement("UPDATE cobros_pendientes SET estado='PAGADO' WHERE id_cobro_pendiente=?")){ps.setInt(1,id);ps.executeUpdate();}conn.commit();out.print("success");
 }else if("Anular".equals(tipo)){
  try(PreparedStatement ps=conn.prepareStatement("UPDATE cobros_pendientes SET estado='ANULADO' WHERE id_cobro_pendiente=? AND origen_tipo IS NULL AND UPPER(COALESCE(estado,'PENDIENTE'))='PENDIENTE'")){ps.setInt(1,Integer.parseInt(request.getParameter("pk")));if(ps.executeUpdate()==0)throw new IllegalArgumentException("Solo se pueden anular cobros directos pendientes. Las facturas anuladas se reflejan automáticamente desde ventas.");}conn.commit();out.print("success");
 }else if("reporte_general".equals(tipo)||"reporte_individual".equals(tipo)){
  boolean individual="reporte_individual".equals(tipo);response.setContentType("text/html; charset=UTF-8");String sql="SELECT c.id_cobro_pendiente,c.concepto,c.monto,c.estado,c.fecha,c.origen_tipo,COALESCE(p.nombre,'') nombre,COALESCE(p.apellido,'') apellido,COALESCE(p.cedula,'') cedula FROM cobros_pendientes c LEFT JOIN pacientes p ON p.id_paciente=c.id_paciente "+(individual?"WHERE c.id_cobro_pendiente=? ":"")+"ORDER BY c.fecha DESC,c.id_cobro_pendiente DESC";
  out.print("<!doctype html><html><head><meta charset='UTF-8'><title>Reporte de cobros | Clinisys</title><style>*{box-sizing:border-box}body{font:14px Arial,sans-serif;margin:32px;color:#343a40;background:#fff}.cabecera{border-bottom:3px solid #007bff;padding:0 0 14px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:center}.marca{font-size:22px;font-weight:700;color:#0756a5}.marca small{display:block;font-size:12px;color:#6c757d;font-weight:400;margin-top:4px}h1{font-size:21px;color:#212529;margin:0}.meta{color:#6c757d;margin:5px 0 18px}.resumen{background:#f1f7ff;border-left:4px solid #007bff;padding:12px 15px;margin:12px 0}.acciones{margin-top:18px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #dee2e6;padding:8px;text-align:left}th{background:#eaf2fb;color:#34495e}tbody tr:nth-child(even){background:#f8f9fa}.num{text-align:right}.estado{font-weight:700}.Pendiente{color:#856404}.PAGADO,.COBRADO{color:#155724}.ANULADO{color:#721c24}@media print{body{margin:12mm}.acciones{display:none}}</style></head><body><div class='cabecera'><div class='marca'>CLINISYS<small>Gestión médica y administrativa</small></div><h1>"+(individual?"Reporte individual de cobro":"Reporte general de cobros")+"</h1></div><p class='meta'>Generado: "+new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())+"</p><table><thead><tr><th>Código</th><th>Paciente</th><th>Cédula</th><th>Concepto</th><th class='num'>Monto</th><th>Estado</th><th>Fecha</th></tr></thead><tbody>");
  try(PreparedStatement ps=conn.prepareStatement(sql)){if(individual)ps.setInt(1,Integer.parseInt(request.getParameter("pk")));try(ResultSet rs=ps.executeQuery()){while(rs.next()){String est=rs.getString("estado");out.print("<tr><td>"+rs.getInt("id_cobro_pendiente")+"</td><td>"+cpEsc(rs.getString("apellido")+", "+rs.getString("nombre"))+"</td><td>"+cpEsc(rs.getString("cedula"))+"</td><td>"+cpEsc(rs.getString("concepto"))+"</td><td class='num'>"+cpEsc(rs.getString("monto"))+"</td><td class='estado "+cpEsc(est)+"'>"+cpEsc(est)+"</td><td>"+cpEsc(rs.getString("fecha"))+"</td></tr>");}}}out.print("</tbody></table><div class='acciones'><button onclick='window.print()' style='background:#007bff;color:#fff;border:0;border-radius:5px;padding:9px 15px'>Imprimir / Guardar como PDF</button></div></body></html>");
 }else{response.setStatus(400);out.print("Operación no reconocida.");}
}catch(Exception e){if("listar".equals(tipo))response.setStatus(500);out.clear();out.print("Error: "+cpEsc(e.getMessage()==null?"No se pudo completar la operación.":e.getMessage()));}
