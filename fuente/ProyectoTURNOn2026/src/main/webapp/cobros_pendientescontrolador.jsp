private String cpEsc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private void cpSincronizar(Connection c) throws SQLException {
    try(Statement st=c.createStatement()){
        st.execute("ALTER TABLE cobros_pendientes ADD COLUMN IF NOT EXISTS origen_tipo VARCHAR(20)");
        st.execute("ALTER TABLE cobros_pendientes ADD COLUMN IF NOT EXISTS origen_id INTEGER");
        st.execute("CREATE UNIQUE INDEX IF NOT EXISTS ux_cobros_pendientes_origen ON cobros_pendientes(origen_tipo,origen_id) WHERE origen_tipo IS NOT NULL");
    }
    String seedCita="INSERT INTO cobros_pendientes(id_paciente,concepto,monto,estado,fecha,origen_tipo,origen_id) SELECT c.id_paciente,LEFT(COALESCE(s.nombre_servicio,'Cita')||' (Cita #'||c.id_cita||')',50),COALESCE(s.precio_unitario,0),CASE WHEN UPPER(COALESCE((SELECT v.estado FROM ventas v JOIN ventas_detalle vd ON vd.id_venta=v.id_venta WHERE vd.tipo_item='SERVICIO' AND vd.id_insumo=c.id_cita ORDER BY v.id_venta DESC LIMIT 1),''))='ANULADO' THEN 'ANULADO' WHEN UPPER(COALESCE(c.estado_pago,'PENDIENTE')) IN ('COBRADO','PAGADO') THEN 'PAGADO' ELSE 'Pendiente' END,COALESCE(c.fecha,CURRENT_DATE),'CITA',c.id_cita FROM citas c LEFT JOIN servicios s ON s.id_servicio=c.id_servicio WHERE NOT EXISTS(SELECT 1 FROM cobros_pendientes cp WHERE cp.origen_tipo='CITA' AND cp.origen_id=c.id_cita) ON CONFLICT (origen_tipo,origen_id) WHERE origen_tipo IS NOT NULL DO NOTHING";
    String seedInt="INSERT INTO cobros_pendientes(id_paciente,concepto,monto,estado,fecha,origen_tipo,origen_id) SELECT i.id_paciente,LEFT('Internación #'||i.id_internacion||' - Hab. '||COALESCE(h.nro_habitacion::text,''),50),COALESCE(h.precio_dia,150000)*COALESCE(i.cant_dias,1),CASE WHEN UPPER(COALESCE((SELECT v.estado FROM ventas v JOIN ventas_detalle vd ON vd.id_venta=v.id_venta WHERE vd.tipo_item='INTERNACION' AND vd.id_insumo=i.id_internacion ORDER BY v.id_venta DESC LIMIT 1),''))='ANULADO' THEN 'ANULADO' WHEN UPPER(COALESCE(i.estado_pago,'PENDIENTE')) IN ('COBRADO','PAGADO') THEN 'PAGADO' ELSE 'Pendiente' END,COALESCE(i.fecha_ingreso,CURRENT_DATE),'INTERNACION',i.id_internacion FROM internaciones i LEFT JOIN habitaciones h ON h.id_habitacion=i.id_habitacion WHERE NOT EXISTS(SELECT 1 FROM cobros_pendientes cp WHERE cp.origen_tipo='INTERNACION' AND cp.origen_id=i.id_internacion) ON CONFLICT (origen_tipo,origen_id) WHERE origen_tipo IS NOT NULL DO NOTHING";
    try(Statement st=c.createStatement()){st.executeUpdate(seedCita);st.executeUpdate(seedInt);}
    String syncCita="UPDATE cobros_pendientes cp SET concepto=LEFT(COALESCE(s.nombre_servicio,'Cita')||' (Cita #'||c.id_cita||')',50),monto=COALESCE(s.precio_unitario,0),fecha=COALESCE(c.fecha,CURRENT_DATE),estado=CASE WHEN UPPER(COALESCE((SELECT v.estado FROM ventas v JOIN ventas_detalle vd ON vd.id_venta=v.id_venta WHERE vd.tipo_item='SERVICIO' AND vd.id_insumo=c.id_cita ORDER BY v.id_venta DESC LIMIT 1),''))='ANULADO' THEN 'ANULADO' WHEN UPPER(COALESCE(c.estado_pago,'PENDIENTE')) IN ('COBRADO','PAGADO') THEN 'PAGADO' ELSE 'Pendiente' END FROM citas c LEFT JOIN servicios s ON s.id_servicio=c.id_servicio WHERE cp.origen_tipo='CITA' AND cp.origen_id=c.id_cita";
    String syncInt="UPDATE cobros_pendientes cp SET concepto=LEFT('Internación #'||i.id_internacion||' - Hab. '||COALESCE(h.nro_habitacion::text,''),50),monto=COALESCE(h.precio_dia,150000)*COALESCE(i.cant_dias,1),fecha=COALESCE(i.fecha_ingreso,CURRENT_DATE),estado=CASE WHEN UPPER(COALESCE((SELECT v.estado FROM ventas v JOIN ventas_detalle vd ON vd.id_venta=v.id_venta WHERE vd.tipo_item='INTERNACION' AND vd.id_insumo=i.id_internacion ORDER BY v.id_venta DESC LIMIT 1),''))='ANULADO' THEN 'ANULADO' WHEN UPPER(COALESCE(i.estado_pago,'PENDIENTE')) IN ('COBRADO','PAGADO') THEN 'PAGADO' ELSE 'Pendiente' END FROM internaciones i LEFT JOIN habitaciones h ON h.id_habitacion=i.id_habitacion WHERE cp.origen_tipo='INTERNACION' AND cp.origen_id=i.id_internacion";
    try(Statement st=c.createStatement()){st.executeUpdate(syncCita);st.executeUpdate(syncInt);}
}
