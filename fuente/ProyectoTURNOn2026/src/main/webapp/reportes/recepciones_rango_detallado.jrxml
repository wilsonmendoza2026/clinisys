<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="recepciones_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="48bcda1e-8fcc-4f26-9fca-029f3fef12b8">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PROVEEDOR" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT r.id_recepcion,r.fecha_recepcion::date AS fecha_recepcion,COALESCE(r.nro_comprobante,'-') AS comprobante,COALESCE(p.razon_social,'Sin Proveedor') AS proveedor,COALESCE(i.nombre_insumo,'Sin Insumo') AS insumo,COALESCE(dr.cantidad,0) AS cantidad,COALESCE(dr.costo_unitario,0)::numeric AS costo_unitario,(COALESCE(dr.cantidad,0)*COALESCE(dr.costo_unitario,0))::numeric AS subtotal,COALESCE(r.estado,'-') AS estado FROM recepciones r LEFT JOIN proveedores p ON r.id_proveedor=p.id_proveedor LEFT JOIN detalles_recepciones dr ON dr.id_recepcion=r.id_recepcion LEFT JOIN insumos i ON dr.id_insumo=i.id_insumo WHERE ($P{MODO_GENERAL} = TRUE OR r.fecha_recepcion::date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESTADO} IS NULL OR UPPER(r.estado) = UPPER($P{ESTADO})) AND ($P{PROVEEDOR} IS NULL OR p.razon_social ILIKE '%' || $P{PROVEEDOR} || '%') ORDER BY r.fecha_recepcion,r.id_recepcion,i.nombre_insumo]]></queryString>
<field name="id_recepcion" class="java.lang.Integer"/>
<field name="fecha_recepcion" class="java.sql.Date"/>
<field name="comprobante" class="java.lang.String"/>
<field name="proveedor" class="java.lang.String"/>
<field name="insumo" class="java.lang.String"/>
<field name="cantidad" class="java.lang.Integer"/>
<field name="costo_unitario" class="java.math.BigDecimal"/>
<field name="subtotal" class="java.math.BigDecimal"/>
<field name="estado" class="java.lang.String"/>
<variable name="sum_subtotal" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
<group name="Grupo_id_recepcion"><groupExpression><![CDATA[$F{id_recepcion}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="62301d53-8024-41fa-bf22-951af85ad722"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="7d1fef86-13ff-469e-b3c5-059c0a425922"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="6632ba92-6ff5-46f3-bf83-7beefba7d0ff"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="edc18f36-b99e-4500-b076-58a2c942b0f2"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE RECEPCIONES]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="ed599d04-c7ed-4a95-b2d3-999482ea5ddc"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="adb7e41c-9d1f-4ef1-8b82-7441c426a136"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Recep.]]></text></staticText><staticText><reportElement mode="Opaque" x="45" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="f2457b7f-958b-4f45-b082-c6494dfec364"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="115" y="0" width="100" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="b9433580-cf97-4348-83b8-adeafb902d7e"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Comprobante]]></text></staticText><staticText><reportElement mode="Opaque" x="215" y="0" width="180" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="eb844977-deb7-478b-a39a-30c854a4d08e"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Proveedor]]></text></staticText><staticText><reportElement mode="Opaque" x="395" y="0" width="190" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="ba5e8bdc-6a5f-4131-b29e-02a70e61be14"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Insumo]]></text></staticText><staticText><reportElement mode="Opaque" x="585" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="168a4f87-8052-410a-888d-ac765368cec7"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Cant.]]></text></staticText><staticText><reportElement mode="Opaque" x="630" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="9479f527-cd30-40ec-9a9f-61a811d811ac"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Costo]]></text></staticText><staticText><reportElement mode="Opaque" x="710" y="0" width="85" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="1384216a-34a4-4439-88d3-2707573a0219"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Subtotal]]></text></staticText><staticText><reportElement mode="Opaque" x="795" y="0" width="107" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="29554103-e1b5-49e2-8e51-ffe096209602"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
<detail><band height="26"><textField><reportElement x="0" y="0" width="45" height="26" uuid="e8b53ee3-03c3-4b21-9f27-9d41138cfba9"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_recepcion}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="45" y="0" width="70" height="26" uuid="bc9dd6ec-9d7d-4119-80ee-c92bbf3f2d11"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_recepcion}]]></textFieldExpression></textField><textField><reportElement x="115" y="0" width="100" height="26" uuid="87808d45-ffd1-49cb-865b-639eccfe54e9"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{comprobante}]]></textFieldExpression></textField><textField><reportElement x="215" y="0" width="180" height="26" uuid="92ced946-3216-4875-a900-2ad16f497402"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField><textField><reportElement x="395" y="0" width="190" height="26" uuid="7e0e1104-1cb6-4031-b2d1-981383e38dbf"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{insumo}]]></textFieldExpression></textField><textField><reportElement x="585" y="0" width="45" height="26" uuid="a51fd20c-12fc-4941-93e6-7fa64362f4c7"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField><textField><reportElement x="630" y="0" width="80" height="26" uuid="3601b862-c71e-4282-aca6-7d614aa04e9a"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{costo_unitario}]]></textFieldExpression></textField><textField><reportElement x="710" y="0" width="85" height="26" uuid="8da76fab-4311-4875-a92a-b68b95829502"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField><textField><reportElement x="795" y="0" width="107" height="26" uuid="ce034d68-8335-43fb-86ca-4edab8238d25"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
