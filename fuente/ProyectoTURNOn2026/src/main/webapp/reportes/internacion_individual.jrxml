<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteInternacionIndividual" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7f4d5baa-dd2f-4ad1-a336-c28ec6af5004">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.backgroundcolor" value="#FFFFFF"/>
	<parameter name="id_internacion" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT 
    i.id_internacion, 
    COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente, 
    COALESCE(h.nro_habitacion || ' (' || h.tipo || ')', 'Sin Asignar') AS habitacion, 
    COALESCE(STRING_AGG(CONCAT(e.nombre, ' ', e.apellido), ', '), 'Sin Enfermeros') AS enfermeros_asignados, 
    TO_CHAR(i.fecha_ingreso, 'DD/MM/YYYY') AS ingreso_format, 
    COALESCE(TO_CHAR(i.fecha_ingreso + (i.cant_dias || ' days')::interval, 'DD/MM/YYYY'), 'En Curso') AS salida_format, 
    COALESCE(i.cant_dias, 1) AS dias 
FROM internaciones i 
LEFT JOIN pacientes p ON i.id_paciente = p.id_paciente 
LEFT JOIN habitaciones h ON i.id_habitacion = h.id_habitacion 
LEFT JOIN internacion_enfermeros ie ON i.id_internacion = ie.id_internacion 
LEFT JOIN enfermeria e ON ie.id_enfermero = e.id_enfermero 
WHERE i.id_internacion = $P{id_internacion}
GROUP BY i.id_internacion, p.apellido, p.nombre, h.nro_habitacion, h.tipo, i.fecha_ingreso, i.cant_dias;]]>
	</queryString>
	<field name="id_internacion" class="java.lang.Integer"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="habitacion" class="java.lang.String"/>
	<field name="enfermeros_asignados" class="java.lang.String"/>
	<field name="ingreso_format" class="java.lang.String"/>
	<field name="salida_format" class="java.lang.String"/>
	<field name="dias" class="java.lang.Integer"/>
