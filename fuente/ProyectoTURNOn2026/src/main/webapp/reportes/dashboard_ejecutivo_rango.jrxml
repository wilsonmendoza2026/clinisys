<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="dashboard_ejecutivo_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="da28b196-83a3-4022-a87b-e81c10ad14d2">
<parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/>
<queryString language="SQL"><![CDATA[SELECT
(SELECT COUNT(*) FROM citas WHERE fecha BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})::integer AS citas,
(SELECT COUNT(*) FROM diagnosticos WHERE fecha_diagnostico BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})::integer AS diagnosticos,
(SELECT COUNT(*) FROM internaciones WHERE fecha_ingreso::date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})::integer AS internaciones,
(SELECT COALESCE(SUM(total_venta),0) FROM ventas WHERE fecha_venta BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})::numeric AS ventas,
(SELECT COALESCE(SUM(utilidad_venta),0) FROM ventas WHERE fecha_venta BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})::numeric AS utilidad,
(SELECT COALESCE(SUM(cantidad*precio_unitario),0) FROM detalles_compras d INNER JOIN compras c ON c.id_compra=d.id_compra WHERE c.fecha_compra BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})::numeric AS compras,
(SELECT COUNT(*) FROM insumos WHERE stock <= stock_minimo)::integer AS stock_bajo,
(SELECT COUNT(*) FROM pacientes WHERE activo IS TRUE)::integer AS pacientes_activos]]></queryString>
<field name="citas" class="java.lang.Integer"/><field name="diagnosticos" class="java.lang.Integer"/><field name="internaciones" class="java.lang.Integer"/><field name="ventas" class="java.math.BigDecimal"/><field name="utilidad" class="java.math.BigDecimal"/><field name="compras" class="java.math.BigDecimal"/><field name="stock_bajo" class="java.lang.Integer"/><field name="pacientes_activos" class="java.lang.Integer"/>
<title><band height="120"><rectangle radius="6"><reportElement x="0" y="0" width="802" height="88" backcolor="#123B5D" uuid="66202d5e-a773-4165-8e36-0055e2f63545"/></rectangle><staticText><reportElement x="0" y="10" width="802" height="35" forecolor="#FFFFFF" uuid="caa6f896-97b7-47d5-84fd-eb5cc3f5f840"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="26" isBold="true"/></textElement><text><![CDATA[ClinicSys | Dashboard Ejecutivo]]></text></staticText><staticText><reportElement x="0" y="48" width="802" height="22" forecolor="#DCEAF4" uuid="c2cf491a-e6c8-4f53-8dc5-67e773dd5434"/><textElement textAlignment="Center"/><text><![CDATA[Resumen gerencial del período seleccionado]]></text></staticText><textField><reportElement x="0" y="95" width="700" height="18" uuid="ef72466d-9a12-48db-a604-0b09758bdb31"/><textElement><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
