<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="inventario_rango_detallado" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="9fd32879-4ae1-47cb-abe4-ba53e45f02df">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PRODUCTO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT i.id_insumo,i.nombre_insumo,COALESCE(m.descripcion_marca,'SIN MARCA') AS marca,COALESCE(c.descripcion_categoria,'SIN CATEGORÍA') AS categoria,COALESCE(i.stock,0) AS stock_actual,COALESCE((SELECT SUM(dc.cantidad) FROM detalles_compras dc INNER JOIN compras cp ON cp.id_compra=dc.id_compra WHERE dc.id_insumo=i.id_insumo ),0)::integer AS entradas,COALESCE((SELECT SUM(vd.cantidad) FROM ventas_detalle vd INNER JOIN ventas vv ON vv.id_venta=vd.id_venta WHERE vd.id_insumo=i.id_insumo AND vd.tipo_item='INSUMO' ),0)::integer AS salidas,COALESCE(i.stock_minimo,5) AS stock_minimo,CASE WHEN COALESCE(i.stock,0)=0 THEN 'SIN STOCK' WHEN i.stock<=COALESCE(i.stock_minimo,5) THEN 'STOCK BAJO' ELSE 'STOCK DISPONIBLE' END AS estado FROM insumos i LEFT JOIN marcas m ON i.id_marca=m.id_marca LEFT JOIN categorias c ON i.id_categoria=c.id_categoria WHERE ($P{PRODUCTO} IS NULL OR i.nombre_insumo ILIKE '%' || $P{PRODUCTO} || '%') ORDER BY i.nombre_insumo]]></queryString>
<field name="id_insumo" class="java.lang.Integer"/>
<field name="nombre_insumo" class="java.lang.String"/>
<field name="marca" class="java.lang.String"/>
<field name="categoria" class="java.lang.String"/>
<field name="stock_actual" class="java.lang.Integer"/>
<field name="entradas" class="java.lang.Integer"/>
<field name="salidas" class="java.lang.Integer"/>
<field name="stock_minimo" class="java.lang.Integer"/>
<field name="estado" class="java.lang.String"/>
<variable name="sum_entradas" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[$F{entradas}]]></variableExpression></variable>
<variable name="sum_salidas" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[$F{salidas}]]></variableExpression></variable>
<group name="Grupo_id_insumo"><groupExpression><![CDATA[$F{id_insumo}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="e97c0b7a-fe7e-45a4-b725-8834190623c7"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="8f31e751-c648-43b6-b695-758351422f48"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="da26441a-0552-42d3-a643-c27f92d68408"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="4046eba5-d281-4123-8301-40bee81fa829"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE INVENTARIO Y MOVIMIENTOS]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="e2b1d9b7-bb25-4ce3-a71b-96cc595749f9"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="42" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="56fc9ac6-2e37-42bb-ad29-53736d98037c"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="42" y="0" width="180" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="9dd06981-f2f4-4fee-a704-2e170490c386"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Insumo]]></text></staticText><staticText><reportElement mode="Opaque" x="222" y="0" width="110" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="b945036a-1005-4748-a4d0-cad87a62dcd9"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Marca]]></text></staticText><staticText><reportElement mode="Opaque" x="332" y="0" width="150" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="7772a7de-42b5-491d-b050-dc5db770ff15"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Categoría]]></text></staticText><staticText><reportElement mode="Opaque" x="482" y="0" width="65" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="636cb056-d7c2-4fc0-bd77-ce51155d1712"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Stock]]></text></staticText><staticText><reportElement mode="Opaque" x="547" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="b947a520-fa40-4bd1-b648-3a0eb748eaa8"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Entradas]]></text></staticText><staticText><reportElement mode="Opaque" x="617" y="0" width="65" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="767d3a57-9304-4013-ac50-18a6bcf6bb43"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Salidas]]></text></staticText><staticText><reportElement mode="Opaque" x="682" y="0" width="65" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="ba335585-5c62-4dc4-a2c3-a79a40c79461"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Mínimo]]></text></staticText><staticText><reportElement mode="Opaque" x="747" y="0" width="55" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="2312b54a-2d42-4b6e-a4fc-85faf48b4f4d"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
<detail><band height="20"><textField><reportElement x="0" y="0" width="42" height="20" uuid="023f35e1-4bd2-4368-8f78-d74699874b8f"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{id_insumo}]]></textFieldExpression></textField><textField><reportElement x="42" y="0" width="180" height="20" uuid="75f71932-7c57-4c57-9433-866c3e96a0b5"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{nombre_insumo}]]></textFieldExpression></textField><textField><reportElement x="222" y="0" width="110" height="20" uuid="1ceb9c0d-0fc6-426c-a3f4-65f8ad4c9cf7"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression></textField><textField><reportElement x="332" y="0" width="150" height="20" uuid="cba4063c-6225-4dca-9a39-a7372c817990"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField><textField><reportElement x="482" y="0" width="65" height="20" uuid="455a1a7a-717d-4e91-bdfa-0806a9f00efb"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{stock_actual}]]></textFieldExpression></textField><textField><reportElement x="547" y="0" width="70" height="20" uuid="5478800a-f504-46b6-844f-ba8c622f53bb"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{entradas}]]></textFieldExpression></textField><textField><reportElement x="617" y="0" width="65" height="20" uuid="27dba37a-574b-4ef6-a5c2-6c6aad0b61f1"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{salidas}]]></textFieldExpression></textField><textField><reportElement x="682" y="0" width="65" height="20" uuid="364aa7e7-e067-4e23-9be8-1456146eedcf"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{stock_minimo}]]></textFieldExpression></textField><textField><reportElement x="747" y="0" width="55" height="20" uuid="ec039fb2-360a-45d8-b07a-8375fd851c13"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
