<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rdiagnosticos_individual" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_diagnostico" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 
    d.id_diagnostico, 
    d.fecha_diagnostico, 
    d.descripcion, 
    COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente, 
    COALESCE(CONCAT(m.apellido, ', ', m.nombre), 'Sin Médico') AS medico,
    COALESCE(e.nombre_especialidad, 'General') AS especialidad
FROM diagnosticos d 
LEFT JOIN pacientes p ON d.id_paciente = p.id_paciente 
LEFT JOIN medicos m ON d.id_medico = m.id_medico 
LEFT JOIN especialidades e ON m.id_especialidad = e.id_especialidad 
WHERE d.id_diagnostico = $P{id_diagnostico}]]>
	</queryString>
	<field name="id_diagnostico" class="java.lang.Integer"/>
	<field name="fecha_diagnostico" class="java.sql.Date"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="especialidad" class="java.lang.String"/>
