<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ventas_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="c784b487-4ad8-4ffc-bb37-e0ce611e7c43">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PACIENTE" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT v.id_venta,v.fecha_venta,COALESCE(v.numero_factura,'-') AS factura,COALESCE(CONCAT(p.apellido,', ',p.nombre),'Sin Paciente') AS paciente,COALESCE(p.cedula,'-') AS cedula_paciente,COALESCE(m.descripcion,'Sin Método') AS metodo_pago,COALESCE(vd.tipo_item,'-') AS tipo_item,COALESCE(i.nombre_insumo,s.nombre_servicio,'Servicio/Producto') AS concepto,vd.cantidad,vd.precio_unitario,(vd.cantidad*vd.precio_unitario)::numeric AS subtotal,COALESCE(v.estado,'-') AS estado FROM ventas v LEFT JOIN pacientes p ON v.id_paciente=p.id_paciente LEFT JOIN metodos_pago m ON v.id_metodo=m.id_metodo LEFT JOIN ventas_detalle vd ON v.id_venta=vd.id_venta LEFT JOIN insumos i ON vd.id_insumo=i.id_insumo AND vd.tipo_item='INSUMO' LEFT JOIN servicios s ON vd.id_insumo=s.id_servicio AND vd.tipo_item='SERVICIO' WHERE ($P{MODO_GENERAL} = TRUE OR v.fecha_venta BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESTADO} IS NULL OR UPPER(v.estado) = UPPER($P{ESTADO})) AND ($P{PACIENTE} IS NULL OR CONCAT(p.apellido, ', ', p.nombre) ILIKE '%' || $P{PACIENTE} || '%') ORDER BY v.fecha_venta,v.id_venta,vd.tipo_item,concepto]]></queryString>
<field name="id_venta" class="java.lang.Integer"/>
<field name="fecha_venta" class="java.sql.Date"/>
<field name="factura" class="java.lang.String"/>
<field name="paciente" class="java.lang.String"/>
<field name="cedula_paciente" class="java.lang.String"/>
<field name="metodo_pago" class="java.lang.String"/>
<field name="tipo_item" class="java.lang.String"/>
<field name="concepto" class="java.lang.String"/>
<field name="cantidad" class="java.lang.Integer"/>
<field name="precio_unitario" class="java.math.BigDecimal"/>
<field name="subtotal" class="java.math.BigDecimal"/>
<field name="estado" class="java.lang.String"/>
<variable name="sum_subtotal" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
<group name="Grupo_id_venta"><groupExpression><![CDATA[$F{id_venta}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="c8c59257-3763-48d7-8bc7-8de2b538a4c2"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="5e9ecf02-952e-43a8-8e5e-f9f4f0e3cbaf"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="b6e3ac87-1430-4e73-a234-2586f1adb8d7"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="fbb0129a-0353-4513-bd42-8b961e9f5617"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE VENTAS Y FACTURACIÓN]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="6c5368f6-47b5-4896-a5c8-afdeed6cf05b"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
