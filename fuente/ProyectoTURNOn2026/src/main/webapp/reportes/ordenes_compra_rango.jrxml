<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ordenes_compra_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="cc89d4df-ba71-479f-9a83-7aa74aa0f3d3">

	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PROVEEDOR" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT o.id_orden, o.fecha_emision,
       COALESCE(p.razon_social, 'Sin Proveedor') AS proveedor,
       COALESCE(o.estado, 'PENDIENTE') AS estado
FROM ordenes_compras o
LEFT JOIN proveedores p ON o.id_proveedor = p.id_proveedor
WHERE ($P{MODO_GENERAL} = TRUE OR o.fecha_emision BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESTADO} IS NULL OR UPPER(o.estado) = UPPER($P{ESTADO})) AND ($P{PROVEEDOR} IS NULL OR p.razon_social ILIKE '%' || $P{PROVEEDOR} || '%') ORDER BY o.fecha_emision, o.id_orden]]></queryString>
	<field name="id_orden" class="java.lang.Integer"/>
	<field name="fecha_emision" class="java.sql.Date"/>
	<field name="proveedor" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#008A52" uuid="0da719f0-54ca-4278-94b3-9888c53a98ad"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="3bc29632-681f-40a0-9e04-36f6974fbadd"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="e208346b-81a8-4cb4-b9ad-e0226441a705"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11"/></textElement><text><![CDATA[INFORME DE ÓRDENES DE COMPRA POR FECHAS]]></text></staticText><textField><reportElement x="0" y="70" width="600" height="18" uuid="bf4579b8-c75c-4c45-aac7-c98df458cde2"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="60" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="ab875bd0-7efa-40ba-86af-2fa86621bcdb"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="60" y="0" width="100" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="2c2fef3b-0e78-495c-9fef-dc0c9e89ab88"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="160" y="0" width="442" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="80d2446c-d86b-4449-8645-d123f90ca27c"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Proveedor]]></text></staticText><staticText><reportElement mode="Opaque" x="602" y="0" width="200" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="1b8661ba-8ce0-4875-ab78-c379d06b77f1"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
	<detail><band height="20"><textField><reportElement x="0" y="0" width="60" height="20" uuid="c358bdd7-5f1c-4257-a52b-3f4baf30b41f"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_orden}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="60" y="0" width="100" height="20" uuid="a3de3075-97c8-4c4d-9fb8-dcfcb5a5099b"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_emision}]]></textFieldExpression></textField><textField><reportElement x="160" y="0" width="442" height="20" uuid="d8869eab-6128-4db9-98a2-8aa1b919cff3"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField><textField><reportElement x="602" y="0" width="200" height="20" uuid="901c0688-bf0a-4653-b4a2-0855b7b789c2"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
