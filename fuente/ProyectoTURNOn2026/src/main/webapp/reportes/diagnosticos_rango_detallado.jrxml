<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="diagnosticos_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="0cec547e-1648-43fa-a779-28f7b841a274">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="ESPECIALIDAD" class="java.lang.String"/><parameter name="MEDICO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT d.id_diagnostico,d.fecha_diagnostico AS fecha,COALESCE(p.cedula,'-') AS cedula_paciente,COALESCE(CONCAT(p.apellido,', ',p.nombre),'Sin Paciente') AS paciente,COALESCE(p.telefono,'-') AS telefono,COALESCE(CONCAT(m.apellido,', ',m.nombre),'Sin Médico') AS medico,COALESCE(m.registro_profesional,'-') AS registro_profesional,COALESCE(d.concepto_cobro,'-') AS concepto,COALESCE(d.descripcion,'-') AS diagnostico FROM diagnosticos d LEFT JOIN pacientes p ON d.id_paciente=p.id_paciente LEFT JOIN medicos m ON d.id_medico=m.id_medico LEFT JOIN especialidades e ON m.id_especialidad=e.id_especialidad WHERE ($P{MODO_GENERAL} = TRUE OR d.fecha_diagnostico BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESPECIALIDAD} IS NULL OR e.nombre_especialidad ILIKE '%' || $P{ESPECIALIDAD} || '%') AND ($P{MEDICO} IS NULL OR CONCAT(m.apellido, ', ', m.nombre) ILIKE '%' || $P{MEDICO} || '%') ORDER BY d.fecha_diagnostico,d.id_diagnostico]]></queryString>
<field name="id_diagnostico" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="cedula_paciente" class="java.lang.String"/>
<field name="paciente" class="java.lang.String"/>
<field name="telefono" class="java.lang.String"/>
<field name="medico" class="java.lang.String"/>
<field name="registro_profesional" class="java.lang.String"/>
<field name="concepto" class="java.lang.String"/>
<field name="diagnostico" class="java.lang.String"/>

<group name="Grupo_id_diagnostico"><groupExpression><![CDATA[$F{id_diagnostico}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="704cf4df-5538-4d22-9089-1d60f0382f36"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="58b31aa6-894e-4e48-bcd6-06f4e3fa2c87"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="d6492532-b755-461f-9745-83f83cd24d96"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="e47758fe-7564-4880-a7df-cb825f8093dc"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE DIAGNÓSTICOS]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="6038a007-511a-4c5e-8c56-e92d69b99300"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
