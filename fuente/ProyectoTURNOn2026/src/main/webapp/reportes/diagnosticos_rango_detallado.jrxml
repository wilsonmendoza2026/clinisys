<detail><band height="26"><textField><reportElement x="0" y="0" width="40" height="26" uuid="e7da2608-0c97-4b61-b6e3-db8efbcdaa53"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_diagnostico}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="40" y="0" width="70" height="26" uuid="d6d90d3b-015b-4735-b1ee-cedc4c23f3a0"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField><textField><reportElement x="110" y="0" width="70" height="26" uuid="cdf89ee6-3969-430c-88a8-8fb8e1aa5670"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{cedula_paciente}]]></textFieldExpression></textField><textField><reportElement x="180" y="0" width="145" height="26" uuid="9921d849-fade-4914-9a74-7d05be5cac60"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{paciente}]]></textFieldExpression></textField><textField><reportElement x="325" y="0" width="80" height="26" uuid="8ac28026-d0ce-4d11-81a8-73a733554c42"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression></textField><textField><reportElement x="405" y="0" width="125" height="26" uuid="de0a5dfd-4c47-48f9-907f-11b5ac8e89ce"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{medico}]]></textFieldExpression></textField><textField><reportElement x="530" y="0" width="75" height="26" uuid="71229c5d-40a4-4ea6-9d8f-e25af00f4dec"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{registro_profesional}]]></textFieldExpression></textField><textField><reportElement x="605" y="0" width="90" height="26" uuid="401cccf9-3b64-452f-ac26-cd5bb914aa10"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression></textField><textField><reportElement x="695" y="0" width="107" height="26" uuid="02c19200-861c-40bf-b1fd-04ffd42b126d"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{diagnostico}]]></textFieldExpression></textField></band></detail>
