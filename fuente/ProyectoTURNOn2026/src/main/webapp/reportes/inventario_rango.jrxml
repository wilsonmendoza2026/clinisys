<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="inventario_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="2e96d86f-869d-4bb1-adaa-14719ee02a17">

	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PRODUCTO" class="java.lang.String"/><parameter name="ESTADO_STOCK" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT i.id_insumo, i.nombre_insumo,
       COALESCE(m.descripcion_marca, 'SIN MARCA') AS marca,
       COALESCE(c.descripcion_categoria, 'SIN CATEGORÍA') AS categoria,
       COALESCE(i.stock, 0) AS stock_actual,
       CASE WHEN COALESCE(i.stock, 0) = 0 THEN 'SIN STOCK'
            WHEN COALESCE(i.stock, 0) <= COALESCE(i.stock_minimo, 5) THEN 'STOCK BAJO'
            ELSE 'STOCK DISPONIBLE' END AS estado
FROM insumos i
LEFT JOIN marcas m ON i.id_marca = m.id_marca
LEFT JOIN categorias c ON i.id_categoria = c.id_categoria
	WHERE ($P{PRODUCTO} IS NULL OR i.nombre_insumo ILIKE '%' || $P{PRODUCTO} || '%')
	  AND ($P{ESTADO_STOCK} IS NULL OR CASE WHEN COALESCE(i.stock, 0) = 0 THEN 'SIN STOCK'
	       WHEN COALESCE(i.stock, 0) <= COALESCE(i.stock_minimo, 5) THEN 'STOCK BAJO'
	       ELSE 'DISPONIBLE' END = $P{ESTADO_STOCK})
ORDER BY i.nombre_insumo]]></queryString>
	<field name="id_insumo" class="java.lang.Integer"/>
	<field name="nombre_insumo" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="stock_actual" class="java.lang.Integer"/>
	<field name="estado" class="java.lang.String"/>
	<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#008A52" uuid="b19c3091-f81e-40c0-bdcb-74453c1228c5"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="bd199add-2852-453d-80b0-2bf5109a6643"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="25773938-4139-4a12-8912-721098a87deb"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11"/></textElement><text><![CDATA[INFORME DE INVENTARIO Y MOVIMIENTOS POR FECHAS]]></text></staticText><textField><reportElement x="0" y="70" width="600" height="18" uuid="fb224910-cbf3-4e09-9246-3f66bdd0feab"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="a81076b7-3774-4383-a246-2c9a242cdfdc"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="45" y="0" width="230" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="6f73f993-af4d-4a05-9c18-737ad25dabb3"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Insumo]]></text></staticText><staticText><reportElement mode="Opaque" x="275" y="0" width="150" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="2c606170-2346-4154-aab7-59fc3beb7ece"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Marca]]></text></staticText><staticText><reportElement mode="Opaque" x="425" y="0" width="180" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="6c620085-5351-46d8-8c7e-7b9f14ea8b17"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Categoría]]></text></staticText><staticText><reportElement mode="Opaque" x="605" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="3d0c5f43-4765-46c2-8306-cadfa130d2c4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Stock]]></text></staticText><staticText><reportElement mode="Opaque" x="685" y="0" width="117" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="ec3ecfe5-a66f-46ae-8d77-e8523c4139cb"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
	<detail><band height="20"><textField><reportElement x="0" y="0" width="45" height="20" uuid="52df362c-5efb-4da0-8af9-761fefb2ec3e"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_insumo}]]></textFieldExpression></textField><textField><reportElement x="45" y="0" width="230" height="20" uuid="7e71b695-fd07-4dcc-9db4-6ea32d40aed4"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{nombre_insumo}]]></textFieldExpression></textField><textField><reportElement x="275" y="0" width="150" height="20" uuid="b3f9f201-1e49-4875-9868-ab6c74c3cd8e"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression></textField><textField><reportElement x="425" y="0" width="180" height="20" uuid="ebe48457-cbaa-4a2f-b3cb-be045b81d7dc"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField><textField><reportElement x="605" y="0" width="80" height="20" uuid="da085ee8-de8f-4831-906d-bb661e415f1c"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{stock_actual}]]></textFieldExpression></textField><textField><reportElement x="685" y="0" width="117" height="20" uuid="d018fe09-d575-498f-a102-789f021e6261"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
