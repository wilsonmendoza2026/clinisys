	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_insumo" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    i.id_insumo, 
    i.nombre_insumo, 
    COALESCE(c.descripcion_categoria, 'Sin Categoría') AS categoria, 
    COALESCE(m.descripcion_marca, 'Sin Marca') AS marca, 
    i.precio_compra, 
    i.precio_venta, 
    i.stock, 
    i.stock_minimo
FROM insumos i
LEFT JOIN categorias c ON i.id_categoria = c.id_categoria
LEFT JOIN marcas m ON i.id_marca = m.id_marca
WHERE i.id_insumo = $P{id_insumo}]]>
	</queryString>
	<field name="id_insumo" class="java.lang.Integer"/>
	<field name="nombre_insumo" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="precio_compra" class="java.math.BigDecimal"/>
	<field name="precio_venta" class="java.math.BigDecimal"/>
	<field name="stock" class="java.lang.Integer"/>
	<field name="stock_minimo" class="java.lang.Integer"/>
