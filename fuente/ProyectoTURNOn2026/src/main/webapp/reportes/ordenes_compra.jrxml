	<queryString language="SQL">
		<![CDATA[SELECT o.id_orden, TO_CHAR(o.fecha_emision, 'DD/MM/YYYY') AS fecha_emision, COALESCE(p.razon_social, 'Sin Proveedor') AS proveedor, COALESCE(o.estado, 'PENDIENTE') AS estado FROM ordenes_compras o LEFT JOIN proveedores p ON o.id_proveedor = p.id_proveedor ORDER BY o.id_orden DESC;]]>
