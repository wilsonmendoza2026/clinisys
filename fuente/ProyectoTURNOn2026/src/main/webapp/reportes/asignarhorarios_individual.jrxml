	<parameter name="id_horario" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT h.id_horario, CONCAT(e.apellido, ', ', e.nombre) AS enfermero, h.dia_semana, h.turno, CONCAT(h.hora_inicio, ' a ', h.hora_fin) AS horario_exacto FROM enfermeria_horarios h JOIN enfermeria e ON h.id_enfermero = e.id_enfermero WHERE h.id_horario = $P{id_horario}]]>
	</queryString>
	<field name="id_horario" class="java.lang.Integer"/>
	<field name="enfermero" class="java.lang.String"/>
	<field name="dia_semana" class="java.lang.String"/>
	<field name="turno" class="java.lang.String"/>
