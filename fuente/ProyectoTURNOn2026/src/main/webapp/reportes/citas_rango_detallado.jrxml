<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="citas_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="f78dcdd3-55b1-4578-a055-1d86770bf85d">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="ESPECIALIDAD" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT c.id_cita,c.fecha,c.hora,COALESCE(p.cedula,'-') AS cedula_paciente,COALESCE(CONCAT(p.apellido,', ',p.nombre),'Sin Paciente') AS paciente,COALESCE(p.telefono,'-') AS telefono,COALESCE(CONCAT(m.apellido,', ',m.nombre),'Sin Médico') AS medico,COALESCE(m.registro_profesional,'-') AS registro_profesional,COALESCE(e.nombre_especialidad,'-') AS especialidad,COALESCE(s.nombre_servicio,'-') AS servicio,COALESCE(c.estado,'-') AS estado,COALESCE(c.estado_pago,'-') AS estado_pago FROM citas c LEFT JOIN pacientes p ON c.id_paciente=p.id_paciente LEFT JOIN medicos m ON c.id_medico=m.id_medico LEFT JOIN especialidades e ON m.id_especialidad=e.id_especialidad LEFT JOIN servicios s ON c.id_servicio=s.id_servicio WHERE ($P{MODO_GENERAL} = TRUE OR c.fecha BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESTADO} IS NULL OR UPPER(c.estado) = UPPER($P{ESTADO})) AND ($P{ESPECIALIDAD} IS NULL OR e.nombre_especialidad ILIKE '%' || $P{ESPECIALIDAD} || '%') ORDER BY c.fecha,c.hora,c.id_cita]]></queryString>
<field name="id_cita" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="hora" class="java.sql.Time"/>
<field name="cedula_paciente" class="java.lang.String"/>
<field name="paciente" class="java.lang.String"/>
<field name="telefono" class="java.lang.String"/>
<field name="medico" class="java.lang.String"/>
<field name="registro_profesional" class="java.lang.String"/>
<field name="especialidad" class="java.lang.String"/>
<field name="servicio" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="estado_pago" class="java.lang.String"/>

<group name="Grupo_id_cita"><groupExpression><![CDATA[$F{id_cita}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="08da13f4-f5ae-4465-b123-84db2ca7026b"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="f35d69fc-655b-4150-920c-34c005020cef"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="54dee353-436c-4744-9368-8e87f9b0fa10"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="921d0d9f-34f6-4633-8ede-7adeb206f181"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE CITAS]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="bfa2e7e5-680e-4123-b6a3-0534091c6c93"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
