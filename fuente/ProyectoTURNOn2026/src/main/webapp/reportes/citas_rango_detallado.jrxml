Field><textField><reportElement x="431" y="0" width="120" height="26" uuid="24e7dbdd-57d5-499e-a9e2-3c71eaeb89aa"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{medico}]]></textFieldExpression></textField><textField><reportElement x="551" y="0" width="75" height="26" uuid="c4a830d3-899e-4c62-b721-fbb08eea159d"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{registro_profesional}]]></textFieldExpression></textField><textField><reportElement x="626" y="0" width="90" height="26" uuid="08f08db5-7049-4d58-9428-23f84d79d932"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{especialidad}]]></textFieldExpression></textField><textField><reportElement x="716" y="0" width="85" height="26" uuid="59880269-d007-468c-b4f7-4ad18e37fedb"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{servicio}]]></textFieldExpression></textField><textField><reportElement x="801" y="0" width="55" height="26" uuid="1d28dda3-27ce-4673-ae2b-4cbaf3d785a3"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField><textField><reportElement x="856" y="0" width="46" height="26" uuid="42b6a06a-90f2-494d-88c7-e9834aed7c52"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado_pago}]]></textFieldExpression></textField></band></detail>
