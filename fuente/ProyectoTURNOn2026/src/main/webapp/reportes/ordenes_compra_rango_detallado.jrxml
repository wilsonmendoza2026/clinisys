<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ordenes_compra_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="d2e829d4-f487-480e-abc2-65d43a5699c1">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PROVEEDOR" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT o.id_orden,o.fecha_emision,COALESCE(p.razon_social,'Sin Proveedor') AS proveedor,COALESCE(p.ruc,'-') AS ruc,COALESCE(i.nombre_insumo,'Sin Insumo') AS insumo,d.cantidad,d.precio_unitario,(d.cantidad*d.precio_unitario)::numeric AS subtotal,COALESCE(o.estado,'-') AS estado FROM ordenes_compras o LEFT JOIN proveedores p ON o.id_proveedor=p.id_proveedor LEFT JOIN detalles_ordenes_compras d ON o.id_orden=d.id_orden LEFT JOIN insumos i ON d.id_insumo=i.id_insumo WHERE ($P{MODO_GENERAL} = TRUE OR o.fecha_emision BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESTADO} IS NULL OR UPPER(o.estado) = UPPER($P{ESTADO})) AND ($P{PROVEEDOR} IS NULL OR p.razon_social ILIKE '%' || $P{PROVEEDOR} || '%') ORDER BY o.fecha_emision,o.id_orden,i.nombre_insumo]]></queryString>
<field name="id_orden" class="java.lang.Integer"/>
<field name="fecha_emision" class="java.sql.Date"/>
<field name="proveedor" class="java.lang.String"/>
<field name="ruc" class="java.lang.String"/>
<field name="insumo" class="java.lang.String"/>
<field name="cantidad" class="java.lang.Integer"/>
<field name="precio_unitario" class="java.math.BigDecimal"/>
<field name="subtotal" class="java.math.BigDecimal"/>
<field name="estado" class="java.lang.String"/>
<variable name="sum_subtotal" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
<group name="Grupo_id_orden"><groupExpression><![CDATA[$F{id_orden}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="dc0519c5-64d2-407b-9251-01d5e9962204"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="ea4bef4d-34d8-433c-8c45-bd2fd15ed1ed"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="bc1f4761-6e41-4cd9-a170-eb00069e6e75"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="dce8c52a-811d-4118-8626-2e3e2ce83153"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE ÓRDENES DE COMPRA]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="74fef60b-9918-4afc-9b5a-eb27b4c5d9fe"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="50" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="99d84e88-ab32-45cd-8c4a-a721ec1891ce"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Orden]]></text></staticText><staticText><reportElement mode="Opaque" x="50" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="e87e3fdd-e242-4414-a0a1-16576d123c93"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="120" y="0" width="180" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="1dab4846-04ae-47df-86fc-8f2cb1fa2b4a"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Proveedor]]></text></staticText><staticText><reportElement mode="Opaque" x="300" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="bee17c6e-ac8c-43f6-a709-9bb133897d7f"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[RUC]]></text></staticText><staticText><reportElement mode="Opaque" x="380" y="0" width="190" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="838f5778-03ee-49bb-8941-9926dd56674b"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Insumo]]></text></staticText><staticText><reportElement mode="Opaque" x="570" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="44d27115-5e5c-45cf-b018-1a56c1239c89"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Cant.]]></text></staticText><staticText><reportElement mode="Opaque" x="615" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="9af8298c-6dcf-48ad-8ef5-a426b85c59c9"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Precio]]></text></staticText><staticText><reportElement mode="Opaque" x="695" y="0" width="85" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="1eaa06f3-08b2-4cb4-85fc-040be8999411"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Subtotal]]></text></staticText><staticText><reportElement mode="Opaque" x="780" y="0" width="122" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="64ba2297-baf2-47da-8c36-5766b8c3865d"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
<detail><band height="26"><textField><reportElement x="0" y="0" width="50" height="26" uuid="9b462148-32b9-45c4-a17b-fa4e59f6c14e"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_orden}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="50" y="0" width="70" height="26" uuid="86397159-476a-4050-bb58-ecfced9074ca"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_emision}]]></textFieldExpression></textField><textField><reportElement x="120" y="0" width="180" height="26" uuid="86cea2a4-fde5-45b5-a1be-68ab8e54a734"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField><textField><reportElement x="300" y="0" width="80" height="26" uuid="1d25b98d-bd95-4185-8508-705c1e51a2b9"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{ruc}]]></textFieldExpression></textField><textField><reportElement x="380" y="0" width="190" height="26" uuid="2a9ece48-064c-496b-aac8-036b2217e23b"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{insumo}]]></textFieldExpression></textField><textField><reportElement x="570" y="0" width="45" height="26" uuid="b12f12cf-bbf0-4d71-a245-eaac6de3353a"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField><textField><reportElement x="615" y="0" width="80" height="26" uuid="1e6714c2-9293-43b3-9a1a-7d6d444e28c3"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{precio_unitario}]]></textFieldExpression></textField><textField><reportElement x="695" y="0" width="85" height="26" uuid="9d77c03b-0446-4d47-a680-10199e1a29c6"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField><textField><reportElement x="780" y="0" width="122" height="26" uuid="deb3c51b-5ed8-427b-8a1f-5393a9712c95"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
