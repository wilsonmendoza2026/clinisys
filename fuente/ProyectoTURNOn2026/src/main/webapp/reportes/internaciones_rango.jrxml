<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="internaciones_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="dc015f69-56fa-482c-b6d8-01bb4883fb37">

	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="HABITACION" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT i.id_internacion,
       COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente,
       COALESCE(h.nro_habitacion, 'Sin Asignar') AS habitacion,
       i.fecha_ingreso::date AS fecha_ingreso,
       COALESCE(i.cant_dias, 1) AS dias,
       COALESCE(i.estado, '-') AS estado
FROM internaciones i
LEFT JOIN pacientes p ON i.id_paciente = p.id_paciente
LEFT JOIN habitaciones h ON i.id_habitacion = h.id_habitacion
WHERE ($P{MODO_GENERAL} = TRUE OR i.fecha_ingreso::date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESTADO} IS NULL OR UPPER(h.estado) = UPPER($P{ESTADO})) AND ($P{HABITACION} IS NULL OR h.nro_habitacion ILIKE '%' || $P{HABITACION} || '%') ORDER BY i.fecha_ingreso, i.id_internacion]]></queryString>
	<field name="id_internacion" class="java.lang.Integer"/>
	<field name="fecha_ingreso" class="java.sql.Date"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="habitacion" class="java.lang.String"/>
	<field name="dias" class="java.lang.Integer"/>
	<field name="estado" class="java.lang.String"/>
	<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#008A52" uuid="84c5611b-aac2-4860-9c1e-4a4336952963"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="ae493d81-5223-4beb-87a1-33e81aa7ea84"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="d3a18e1a-3a5e-403a-be8b-107edcf34a29"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11"/></textElement><text><![CDATA[INFORME DE INTERNACIONES POR FECHAS]]></text></staticText><textField><reportElement x="0" y="70" width="600" height="18" uuid="170f9bce-b3a2-40b8-8aea-cabfb7076a8b"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="8a5c6d94-397a-49a6-bcf5-2882e07a839a"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="45" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="c4b7375d-2490-49ea-b6c3-5ab5a1fc8539"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="125" y="0" width="230" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="fc935b8b-81cf-4df9-8e33-a0aa14798c7b"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Paciente]]></text></staticText><staticText><reportElement mode="Opaque" x="355" y="0" width="170" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="834e7821-e04a-4bbc-9716-db1988b68f77"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Habitación]]></text></staticText><staticText><reportElement mode="Opaque" x="525" y="0" width="60" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="304d3309-374c-470a-83a5-3419c8948fa6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Días]]></text></staticText><staticText><reportElement mode="Opaque" x="585" y="0" width="217" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="93b49e34-04d9-496d-926d-bd33a97db454"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
	<detail><band height="20"><textField><reportElement x="0" y="0" width="45" height="20" uuid="ff9c98f2-b11e-4d30-a3fc-54c886f0326a"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_internacion}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="45" y="0" width="80" height="20" uuid="f7996a6f-5760-4eeb-aca3-ea0e6275c607"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_ingreso}]]></textFieldExpression></textField><textField><reportElement x="125" y="0" width="230" height="20" uuid="2f729d53-04ff-462d-a92a-16b69f6c13d9"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{paciente}]]></textFieldExpression></textField><textField><reportElement x="355" y="0" width="170" height="20" uuid="d1903111-5b7b-4778-b7ef-e1b93533e32f"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{habitacion}]]></textFieldExpression></textField><textField><reportElement x="525" y="0" width="60" height="20" uuid="445e3805-7e1f-4be5-8c60-21c1321b62d2"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{dias}]]></textFieldExpression></textField><textField><reportElement x="585" y="0" width="217" height="20" uuid="1d965dbd-6489-48ca-a8da-8a391a5ea8c1"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpres