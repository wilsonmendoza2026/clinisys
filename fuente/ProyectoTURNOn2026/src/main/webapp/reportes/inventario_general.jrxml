<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="inventario_general" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b1e2d3c4-5f6a-4b7c-8d9e-0f1a2b3c4d5e">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="estiloEstado" forecolor="#333333" fontName="Arial" fontSize="10" isBold="true">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{estado}.equals("SIN STOCK")]]></conditionExpression>
			<style forecolor="#C0392B"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{estado}.equals("STOCK BAJO")]]></conditionExpression>
			<style forecolor="#B7950B"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{estado}.equals("STOCK DISPONIBLE")]]></conditionExpression>
			<style forecolor="#1E8449"/>
		</conditionalStyle>
	</style>
	<queryString language="SQL">
		<![CDATA[SELECT i.id_insumo,
       i.nombre_insumo,
       COALESCE(m.descripcion_marca, 'SIN MARCA') AS marca,
       COALESCE(c.descripcion_categoria, 'SIN CATEGORÍA') AS categoria,
       COALESCE(s.cantidad, 0) AS stock_actual,
       CASE WHEN COALESCE(s.cantidad, 0) = 0 THEN 'SIN STOCK'
            WHEN COALESCE(s.cantidad, 0) <= 5 THEN 'STOCK BAJO'
            ELSE 'STOCK DISPONIBLE' END AS estado
FROM insumos i
LEFT JOIN marcas m ON i.id_marca = m.id_marca
LEFT JOIN categorias c ON i.id_categoria = c.id_categoria
LEFT JOIN stock s ON i.id_insumo = s.id_insumo
ORDER BY i.nombre_insumo ASC]]>
	</queryString>
	<field name="id_insumo" class="java.lang.Integer"/>
	<field name="nombre_insumo" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="stock_actual" class="java.lang.Integer"/>
	<field name="estado" class="java.lang.String"/>
	<variable name="totalInsumos" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{id_insumo}]]></variableExpression>
	</variable>
