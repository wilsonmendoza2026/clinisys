	<queryString language="SQL">
		<![CDATA[SELECT id_paciente, COALESCE(cedula, '-') AS cedula, CONCAT(nombre, ' ', apellido) AS paciente, COALESCE(telefono, '-') AS telefono, COALESCE(direccion, '-') AS direccion, CASE WHEN activo IS TRUE THEN 'ACTIVO' ELSE 'INACTIVO' END AS estado FROM pacientes ORDER BY id_paciente ASC;]]>
