<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FichaRol" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="55af1ffc-6613-4190-b10e-5af2f612b5f1">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_rol" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    r.id_rol,
    r.nombre_rol,
    r.descripcion,
    COALESCE(
        string_agg(
            m.nombre_modulo || ': ' ||
            COALESCE(
                NULLIF(
                    CONCAT_WS(', ',
                        CASE WHEN rm.puede_ver THEN 'Ver' END,
                        CASE WHEN rm.puede_crear THEN 'Crear' END,
                        CASE WHEN rm.puede_editar THEN 'Editar' END,
                        CASE WHEN rm.puede_eliminar THEN 'Eliminar' END
                    ),
                    ''
                ),
                'Sin acciones'
            ),
            ', ' ORDER BY m.id_modulo
        ),
        'Sin permisos'
    ) AS permiso_modulo
FROM roles r
LEFT JOIN roles_modulos rm 
       ON rm.id_rol = r.id_rol
LEFT JOIN modulos m 
       ON m.id_modulo = rm.id_modulo
WHERE r.id_rol = $P{id_rol}
GROUP BY 
    r.id_rol,
    r.nombre_rol,
    r.descripcion;
]]>
	</queryString>
	<field name="id_rol" class="java.lang.Integer"/>
	<field name="nombre_rol" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="permiso_modulo" class="java.lang.String"/>
