<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CitasPorFechas" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="1f59db8c-037c-4cc5-bf7c-11039800afd5">
	<style name="Zebra" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F4F6F7"/>
		</conditionalStyle>
	</style>
	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="ESPECIALIDAD" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT c.id_cita,
       COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente,
       COALESCE(CONCAT(m.apellido, ', ', m.nombre), 'Sin Médico') AS medico,
       COALESCE(e.nombre_especialidad, '-') AS especialidad,
       COALESCE(s.nombre_servicio, '-') AS servicio,
       c.fecha, c.hora,
       COALESCE(c.estado, '-') AS estado,
       COALESCE(c.estado_pago, '-') AS estado_pago
FROM citas c
LEFT JOIN pacientes p ON c.id_paciente = p.id_paciente
LEFT JOIN medicos m ON c.id_medico = m.id_medico
LEFT JOIN especialidades e ON m.id_especialidad = e.id_especialidad
LEFT JOIN servicios s ON c.id_servicio = s.id_servicio
WHERE ($P{MODO_GENERAL} = TRUE OR c.fecha BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESTADO} IS NULL OR UPPER(c.estado) = UPPER($P{ESTADO})) AND ($P{ESPECIALIDAD} IS NULL OR e.nombre_especialidad ILIKE '%' || $P{ESPECIALIDAD} || '%') ORDER BY c.fecha, c.hora, c.id_cita]]></queryString>
	<field name="id_cita" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora" class="java.sql.Time"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="especialidad" class="java.lang.String"/>
	<field name="servicio" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="estado_pago" class="java.lang.String"/>
