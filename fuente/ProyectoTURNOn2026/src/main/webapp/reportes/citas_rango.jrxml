			<textField><reportElement x="0" y="72" width="500" height="20" forecolor="#2C3E50" uuid="df2b6d0a-07ae-43b6-9621-244f279fbb37"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField>
		</band>
