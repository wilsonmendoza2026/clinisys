<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ventas_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="be95b34e-045e-4bf6-87b4-0b5f3fe07615">

	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PACIENTE" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT v.id_venta, v.fecha_venta,
       COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente,
       COALESCE(v.numero_factura, '-') AS factura,
       COALESCE(m.descripcion, 'Sin Método') AS metodo_pago,
       COALESCE(v.total_venta, 0)::numeric AS total,
       COALESCE(v.estado, '-') AS estado
FROM ventas v
LEFT JOIN pacientes p ON v.id_paciente = p.id_paciente
LEFT JOIN metodos_pago m ON v.id_metodo = m.id_metodo
WHERE ($P{MODO_GENERAL} = TRUE OR v.fecha_venta BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESTADO} IS NULL OR UPPER(v.estado) = UPPER($P{ESTADO})) AND ($P{PACIENTE} IS NULL OR CONCAT(p.apellido, ', ', p.nombre) ILIKE '%' || $P{PACIENTE} || '%') ORDER BY v.fecha_venta, v.id_venta]]></queryString>
	<field name="id_venta" class="java.lang.Integer"/>
	<field name="fecha_venta" class="java.sql.Date"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="factura" class="java.lang.String"/>
	<field name="metodo_pago" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="estado" class="java.lang.String"/>
	<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#008A52" uuid="72930266-40f4-4604-8fb9-2cd8920659b2"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="d193dafa-12d2-4c5b-8f6f-ff713ff1a890"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="6beb9300-8444-4d3a-b477-4d1485243f7e"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11"/></textElement><text><![CDATA[INFORME DE VENTAS Y FACTURACIÓN POR FECHAS]]></text></staticText><textField><reportElement x="0" y="70" width="600" height="18" uuid="9dca595c-c08e-459a-a4da-78957f101711"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="a52af736-0dde-4695-9de6-c91951387cad"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="45" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="3924d741-48c6-46eb-b200-67f9ce687479"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="125" y="0" width="220" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="a7c8f062-12b8-4443-883a-cfc8d26eb276"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Paciente]]></text></staticText><staticText><reportElement mode="Opaque" x="345" y="0" width="120" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="16e4d862-7189-417d-8a00-8cfc49283f99"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Factura]]></text></staticText><staticText><reportElement mode="Opaque" x="465" y="0" width="130" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="25521734-a4bd-43f6-a2c3-7bb62779edef"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Método]]></text></staticText><staticText><reportElement mode="Opaque" x="595" y="0" width="100" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="eb0366c0-a995-4070-aad2-659d00c5c043"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText><staticText><reportElement mode="Opaque" x="695" y="0" width="107" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="3f94ca1a-74e9-4bad-abdc-3c624e7ab272"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
