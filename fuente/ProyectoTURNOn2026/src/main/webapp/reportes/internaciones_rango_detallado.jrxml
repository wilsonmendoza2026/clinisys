<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="internaciones_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="3845334e-872e-41fe-be78-40e3b76c6675">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="HABITACION" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT i.id_internacion,i.fecha_ingreso::date AS fecha_ingreso,COALESCE(CONCAT(p.apellido,', ',p.nombre),'Sin Paciente') AS paciente,COALESCE(p.cedula,'-') AS cedula_paciente,COALESCE(h.nro_habitacion,'Sin Asignar') AS habitacion,COALESCE(h.tipo,'-') AS tipo_habitacion,COALESCE(i.cant_dias,1) AS dias,COALESCE(h.precio_dia,0)::numeric AS precio_dia,(COALESCE(i.cant_dias,1)*COALESCE(h.precio_dia,0))::numeric AS total_hospedaje,COALESCE(CONCAT(en.nombre,' ',en.apellido),'Sin Responsable') AS enfermero,COALESCE(i.estado,'-') AS estado,COALESCE(i.estado_pago,'-') AS estado_pago FROM internaciones i LEFT JOIN pacientes p ON i.id_paciente=p.id_paciente LEFT JOIN habitaciones h ON i.id_habitacion=h.id_habitacion LEFT JOIN enfermeria en ON i.id_enfermero_responsable=en.id_enfermero WHERE ($P{MODO_GENERAL} = TRUE OR i.fecha_ingreso::date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESTADO} IS NULL OR UPPER(h.estado) = UPPER($P{ESTADO})) AND ($P{HABITACION} IS NULL OR h.nro_habitacion ILIKE '%' || $P{HABITACION} || '%') ORDER BY i.fecha_ingreso,i.id_internacion]]></queryString>
<field name="id_internacion" class="java.lang.Integer"/>
<field name="fecha_ingreso" class="java.sql.Date"/>
<field name="paciente" class="java.lang.String"/>
<field name="cedula_paciente" class="java.lang.String"/>
<field name="habitacion" class="java.lang.String"/>
<field name="tipo_habitacion" class="java.lang.String"/>
<field name="dias" class="java.lang.Integer"/>
<field name="precio_dia" class="java.math.BigDecimal"/>
<field name="total_hospedaje" class="java.math.BigDecimal"/>
<field name="enfermero" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="estado_pago" class="java.lang.String"/>
<variable name="sum_total_hospedaje" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{total_hospedaje}]]></variableExpression></variable>
<group name="Grupo_id_internacion"><groupExpression><![CDATA[$F{id_internacion}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="ba64c7b8-b24c-4037-bfc8-49adb557918b"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="cbe12d0d-688a-46d7-862b-3eb1c87ad848"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="7d2269a6-229c-4faf-8d91-b19b05aea32a"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="76d23b59-92a3-4d88-bbd4-7536711d397f"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE INTERNACIONES]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="985d7928-e295-4b03-a5cb-12ab52ed1421"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="38" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="d78e39ab-d07e-452e-9439-bf13ea89f16d"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="38" y="0" width="65" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="0c185b9a-a743-4a03-8ea3-a6fce8d4a719"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Ingreso]]></text></staticText><staticText><reportElement mode="Opaque" x="103" y="0" width="130" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="354ef194-5eff-484a-9ff1-630d244057ed"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Paciente]]></text></staticText><staticText><reportElement mode="Opaque" x="233" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="3b3731e7-b00f-4813-9bb5-b41427deb8ef"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Cédula]]></text></staticText><staticText><reportElement mode="Opaque" x="303" y="0" width="55" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="247a9a02-88a6-4963-ae0a-fbafa7b81850"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Hab.]]></text></staticText><staticText><reportElement mode="Opaque" x="358" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="ca42845a-f428-4516-8461-017c24b0837c"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Tipo]]></text></