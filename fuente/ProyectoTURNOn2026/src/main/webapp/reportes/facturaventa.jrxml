<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="facturaventa" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="23dc1d41-ee5e-443e-93e7-f76256147cb2">
	<property name="ireport.zoom" value="1.21"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ID_VENTA" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[49]]></defaultValueExpression>
	</parameter>
	<parameter name="MONTO_LETRAS" class="java.lang.String">
		<defaultValueExpression><![CDATA["CERO GUARANÍES"]]></defaultValueExpression>
	</parameter>
	<parameter name="RUC_EMISOR" class="java.lang.String">
		<defaultValueExpression><![CDATA["80000000-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    v.numero_factura,
    v.fecha_venta,
    v.estado,
    COALESCE(NULLIF(v.titular_factura_cedula, ''), p.cedula) AS ruc_ci_paciente,
    COALESCE(NULLIF(v.titular_factura_nombre, ''), p.nombre || ' ' || p.apellido) ||
        CASE WHEN NULLIF(v.titular_factura_parentesco, '') IS NULL THEN ''
             ELSE ' (' || v.titular_factura_parentesco || ')' END AS titular_factura,
    p.nombre || ' ' || p.apellido AS paciente,
    p.direccion,
    p.telefono,
    COALESCE(m.descripcion, 'EFECTIVO') AS metodo_pago,
    vd.tipo_item AS tipo,
    vd.tipo_iva,
    CASE
        WHEN vd.tipo_item = 'INSUMO' THEN i.nombre_insumo
        WHEN vd.tipo_item = 'SERVICIO' THEN COALESCE(s_directo.nombre_servicio, s_cita.nombre_servicio, 'SERVICIO GENERAL')
        WHEN vd.tipo_item = 'INTERNACION' THEN 'Internación Nro: ' || intn.id_internacion || ' - Hab: ' || h.nro_habitacion
        ELSE 'OTROS'
    END AS concepto,
    vd.cantidad,
    vd.precio_unitario,
    (vd.cantidad * vd.precio_unitario) AS subtotal,
    v.subtotal_exenta,
    v.subtotal_iva5,
    v.subtotal_iva10,
    v.liquidacion_iva5,
    v.liquidacion_iva10,
    v.total_iva,
    COALESCE(v.total_venta, 0) AS total_venta
FROM public.ventas v
INNER JOIN public.pacientes p ON v.id_paciente = p.id_paciente
LEFT JOIN public.metodos_pago m ON v.id_metodo = m.id_metodo
INNER JOIN public.ventas_detalle vd ON v.id_venta = vd.id_venta
LEFT JOIN public.insumos i ON vd.id_insumo = i.id_insumo AND vd.tipo_item = 'INSUMO'
LEFT JOIN public.citas c ON vd.id_insumo = c.id_cita AND vd.tipo_item = 'SERVICIO'
LEFT JOIN public.servicios s_cita ON c.id_servicio = s_cita.id_servicio
LEFT JOIN public.servicios s_directo ON vd.id_insumo = s_directo.id_servicio AND vd.tipo_item = 'SERVICIO'
LEFT JOIN public.internaciones intn ON vd.id_insumo = intn.id_internacion AND vd.tipo_item = 'INTERNACION'
LEFT JOIN public.habitaciones h ON intn.id_habitacion = h.id_habitacion
WHERE v.id_venta = $P{ID_VENTA}
ORDER BY vd.tipo_item, concepto]]>
	</queryString>
	<field name="numero_factura" class="java.lang.String"/>
	<field name="fecha_venta" class="java.sql.Date"/>
	<field name="estado" class="java.lang.String"/>
	<field name="ruc_ci_paciente" class="java.lang.String"/>
	<field name="titular_factura" class="java.lang.String"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="metodo_pago" class="java.lang.String"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="tipo_iva" class="java.lang.Integer"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="precio_unitario" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="subtotal_exenta" class="java.math.BigDecimal"/>
	<field name="subtotal_iva5" class="java.math.BigDecimal"/>
	<field name="subtotal_iva10" class="java.math.BigDecimal"/>
	<field name="liquidacion_iva5" class="java.math.BigDecimal"/>
	<field name="liquidacion_iva10" class="java.math.BigDecimal"/>
	<field name="total_iva" class="java.math.BigDecimal"/>
	<field name="total_venta" class="java.math.BigDecimal"/>
