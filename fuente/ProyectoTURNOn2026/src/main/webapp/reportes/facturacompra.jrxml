<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="facturacompra" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0e18b7f5-94c4-4b8e-ae5e-4f3d7a3c1111">
	<property name="ireport.zoom" value="1.21"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>

	<parameter name="ID_COMPRA" class="java.lang.Integer"/>

	<queryString language="SQL">
		<![CDATA[
SELECT
    c.numero_factura,
    c.fecha_compra,
    c.estado_compra,
    COALESCE(c.forma_pago, 'CONTADO') AS forma_pago,
    COALESCE(p.razon_social, '-') AS proveedor,
    COALESCE(p.ruc, '-') AS ruc_proveedor,
    d.id_insumo,
    i.nombre_insumo,
    d.cantidad,
    d.precio_unitario,
    (d.cantidad * d.precio_unitario)::numeric AS subtotal,
    SUM(d.cantidad * d.precio_unitario) OVER ()::numeric AS total_compra
FROM compras c
INNER JOIN proveedores p ON c.id_proveedor = p.id_proveedor
INNER JOIN detalles_compras d ON c.id_compra = d.id_compra
INNER JOIN insumos i ON d.id_insumo = i.id_insumo
WHERE c.id_compra = $P{ID_COMPRA}
ORDER BY i.nombre_insumo
		]]>
	</queryString>

	<field name="numero_factura" class="java.lang.String"/>
	<field name="fecha_compra" class="java.sql.Date"/>
	<field name="estado_compra" class="java.lang.String"/>
	<field name="forma_pago" class="java.lang.String"/>
	<field name="proveedor" class="java.lang.String"/>
	<field name="ruc_proveedor" class="java.lang.String"/>
	<field name="id_insumo" class="java.lang.Integer"/>
	<field name="nombre_insumo" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="precio_unitario" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="total_compra" class="java.math.BigDecimal"/>

	<variable name="totalGeneral" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>

