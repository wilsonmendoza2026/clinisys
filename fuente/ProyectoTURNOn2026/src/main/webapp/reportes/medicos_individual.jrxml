	<property name="ireport.zoom" value="1.10"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_id_medico" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    m.id_medico, 
    m.nombre, 
    m.apellido, 
    m.registro_profesional, 
    COALESCE(e.nombre_especialidad, 'Sin definir') AS nombre_especialidad, 
    COALESCE(m.turno, '-') AS turno, 
    COALESCE(m.dias_atencion, '-') AS dias_atencion, 
    COALESCE(m.horario_atencion, '-') AS horario_atencion
FROM medicos m
LEFT JOIN especialidades e ON m.id_especialidad = e.id_especialidad
WHERE m.id_medico = $P{p_id_medico}]]>
	</queryString>
	<field name="id_medico" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="registro_profesional" class="java.lang.String"/>
	<field name="nombre_especialidad" class="java.lang.String"/>
	<field name="turno" class="java.lang.String"/>
	<field name="dias_atencion" class="java.lang.String"/>
	<field name="horario_atencion" class="java.lang.String"/>
