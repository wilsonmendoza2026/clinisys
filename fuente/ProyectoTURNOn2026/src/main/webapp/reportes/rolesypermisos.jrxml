<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ListadoRoles" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="cc1b3049-9ceb-4412-a835-c78b776b0789">
	<property name="ireport.zoom" value="1.4641000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
		<queryString language="SQL">
			<![CDATA[SELECT r.id_rol, r.nombre_rol, r.descripcion,
COALESCE(string_agg(m.nombre_modulo || ': ' ||
    TRIM(BOTH ', ' FROM
        (CASE WHEN rm.puede_ver THEN 'Ver, ' ELSE '' END ||
         CASE WHEN rm.puede_crear THEN 'Crear, ' ELSE '' END ||
         CASE WHEN rm.puede_editar THEN 'Editar, ' ELSE '' END ||
         CASE WHEN rm.puede_eliminar THEN 'Eliminar, ' ELSE '' END)),
    ', ' ORDER BY m.id_modulo), 'Sin permisos') AS permiso_modulo
FROM roles r
LEFT JOIN roles_modulos rm ON rm.id_rol = r.id_rol
LEFT JOIN modulos m ON m.id_modulo = rm.id_modulo
GROUP BY r.id_rol, r.nombre_rol, r.descripcion
ORDER BY r.id_rol;]]>
	</queryString>
	<field name="id_rol" class="java.lang.Integer"/>
	<field name="nombre_rol" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="permiso_modulo" class="java.lang.String"/>
