<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="recepcion_general" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b1e2d3c4-5f6a-4b7c-8d9e-0f1a2b3c4d5e">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT r.id_recepcion,
       COALESCE(r.nro_comprobante, '-') AS nro_comprobante,
       r.fecha_recepcion,
       p.razon_social AS proveedor,
       COALESCE(r.observacion, '-') AS observacion,
       r.estado,
       COALESCE(SUM(dr.cantidad * dr.costo_unitario), 0)::numeric AS total
FROM recepciones r
INNER JOIN proveedores p ON r.id_proveedor = p.id_proveedor
LEFT JOIN detalles_recepciones dr ON dr.id_recepcion = r.id_recepcion
GROUP BY r.id_recepcion, r.nro_comprobante, r.fecha_recepcion, p.razon_social, r.observacion, r.estado
ORDER BY r.id_recepcion DESC]]>
	</queryString>
	<field name="id_recepcion" class="java.lang.Integer"/>
	<field name="nro_comprobante" class="java.lang.String"/>
	<field name="fecha_recepcion" class="java.sql.Timestamp"/>
	<field name="proveedor" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="totalRecepciones" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{id_recepcion}]]></variableExpression>
	</variable>
