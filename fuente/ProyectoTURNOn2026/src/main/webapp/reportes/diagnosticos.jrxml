	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    d.id_diagnostico, 
    COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente, 
    COALESCE(CONCAT(m.apellido, ', ', m.nombre), 'Sin Médico') AS medico, 
    d.descripcion AS diagnostico, 
    d.fecha_diagnostico AS fecha 
FROM diagnosticos d 
LEFT JOIN pacientes p ON d.id_paciente = p.id_paciente 
LEFT JOIN medicos m ON d.id_medico = m.id_medico 
ORDER BY d.id_diagnostico DESC;]]>
	</queryString>
	<field name="id_diagnostico" class="java.lang.Integer"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="diagnostico" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
