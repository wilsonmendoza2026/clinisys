			<textField><reportElement x="0" y="72" width="500" height="20" forecolor="#2C3E50" uuid="0888cae1-b8f7-4d08-8195-d18df7d477c3"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField>
