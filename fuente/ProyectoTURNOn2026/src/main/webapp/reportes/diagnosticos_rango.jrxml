<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DiagnosticosPorFechas" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="aea5dc9d-2e1b-4c4b-9d00-597324df3b7d">
	<style name="Zebra" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F4F6F7"/>
		</conditionalStyle>
	</style>
	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="ESPECIALIDAD" class="java.lang.String"/><parameter name="MEDICO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT d.id_diagnostico,
       COALESCE(CONCAT(p.apellido, ', ', p.nombre), 'Sin Paciente') AS paciente,
       COALESCE(CONCAT(m.apellido, ', ', m.nombre), 'Sin Médico') AS medico,
       COALESCE(d.concepto_cobro, '-') AS concepto,
       COALESCE(d.descripcion, '-') AS diagnostico,
       d.fecha_diagnostico AS fecha
FROM diagnosticos d
LEFT JOIN pacientes p ON d.id_paciente = p.id_paciente
LEFT JOIN medicos m ON d.id_medico = m.id_medico LEFT JOIN especialidades e ON m.id_especialidad = e.id_especialidad
WHERE ($P{MODO_GENERAL} = TRUE OR d.fecha_diagnostico BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESPECIALIDAD} IS NULL OR e.nombre_especialidad ILIKE '%' || $P{ESPECIALIDAD} || '%') AND ($P{MEDICO} IS NULL OR CONCAT(m.apellido, ', ', m.nombre) ILIKE '%' || $P{MEDICO} || '%') ORDER BY d.fecha_diagnostico, d.id_diagnostico]]></queryString>
	<field name="id_diagnostico" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="diagnostico" class="java.lang.String"/>
