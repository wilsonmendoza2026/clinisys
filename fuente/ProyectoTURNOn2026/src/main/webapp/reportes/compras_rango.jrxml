<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="compras_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="1ac7daaa-61ae-4abb-83a1-18b39ea1e96e">

	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PROVEEDOR" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT c.id_compra, c.fecha_compra,
       COALESCE(p.razon_social, 'Sin Proveedor') AS proveedor,
       COALESCE(c.numero_factura, '-') AS factura,
       COALESCE(c.estado_compra, '-') AS estado
FROM compras c
LEFT JOIN proveedores p ON c.id_proveedor = p.id_proveedor
WHERE ($P{MODO_GENERAL} = TRUE OR c.fecha_compra BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESTADO} IS NULL OR UPPER(c.estado_compra) = UPPER($P{ESTADO})) AND ($P{PROVEEDOR} IS NULL OR p.razon_social ILIKE '%' || $P{PROVEEDOR} || '%') ORDER BY c.fecha_compra, c.id_compra]]></queryString>
	<field name="id_compra" class="java.lang.Integer"/>
	<field name="fecha_compra" class="java.sql.Date"/>
	<field name="proveedor" class="java.lang.String"/>
	<field name="factura" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#008A52" uuid="e696399c-96f5-407b-b082-7b2b75367632"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="0d916f1f-deaa-4ec4-ab25-e51381265361"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="f6a5241c-ca4c-4936-8ebd-cee1a5d33d7b"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11"/></textElement><text><![CDATA[INFORME DE COMPRAS POR FECHAS]]></text></staticText><textField><reportElement x="0" y="70" width="600" height="18" uuid="528dbaf1-3dc3-4711-b70d-f313c9ab0eb6"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="55" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="1afc68ea-9424-45d9-8b35-616d6817da88"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="55" y="0" width="95" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="0de3cf05-1f7e-4ded-9dd6-8f9275239f9d"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="150" y="0" width="350" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="68cd9577-221a-4d18-b45c-111644c10e19"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Proveedor]]></text></staticText><staticText><reportElement mode="Opaque" x="500" y="0" width="160" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="cca7f396-182a-465f-ad4d-e22a24cb40ae"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Factura]]></text></staticText><staticText><reportElement mode="Opaque" x="660" y="0" width="142" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="944c8e91-a82a-415f-9452-6b6f62b7381f"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
	<detail><band height="20"><textField><reportElement x="0" y="0" width="55" height="20" uuid="b9fbd45f-af2f-4e1b-929f-346cd37e5789"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_compra}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="55" y="0" width="95" height="20" uuid="01755c5f-f6c6-4747-9a78-c29b26a1ea1e"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_compra}]]></textFieldExpression></textField><textField><reportElement x="150" y="0" width="350" height="20" uuid="8d63cc52-8dee-4c67-8cca-ca5a9d019b82"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField><textField><reportElement x="500" y="0" width="160" height="20" uuid="e005a1e0-aaf8-41c4-ac0a-b8dda6cef497"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{factura}]]></textFieldExpression></textField><textField><reportElement x="660" y="0" width="142" height="20" uuid="bc169612-acc1-499d-940d-6d1cbe90473c"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
