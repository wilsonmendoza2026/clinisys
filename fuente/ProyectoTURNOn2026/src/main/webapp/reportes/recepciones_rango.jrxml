<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="recepciones_rango" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="5812d49f-c656-4cde-a004-ec350a9beb98">

	<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PROVEEDOR" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT r.id_recepcion, r.fecha_recepcion::date AS fecha_recepcion,
       COALESCE(r.nro_comprobante, '-') AS comprobante,
       COALESCE(p.razon_social, 'Sin Proveedor') AS proveedor,
       COALESCE(r.estado, '-') AS estado,
       COALESCE(r.total, 0)::numeric AS total
FROM recepciones r
LEFT JOIN proveedores p ON r.id_proveedor = p.id_proveedor
WHERE ($P{MODO_GENERAL} = TRUE OR r.fecha_recepcion::date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN})
AND ($P{ESTADO} IS NULL OR UPPER(r.estado) = UPPER($P{ESTADO})) AND ($P{PROVEEDOR} IS NULL OR p.razon_social ILIKE '%' || $P{PROVEEDOR} || '%') ORDER BY r.fecha_recepcion, r.id_recepcion]]></queryString>
	<field name="id_recepcion" class="java.lang.Integer"/>
	<field name="fecha_recepcion" class="java.sql.Date"/>
	<field name="comprobante" class="java.lang.String"/>
	<field name="proveedor" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#008A52" uuid="6ee8d909-3179-4372-b4d7-2e024f26aaf9"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="804e074e-a16b-4699-8e12-d10d416c9269"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="cdf8cc02-ee88-4098-9e12-1b5cb548374e"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11"/></textElement><text><![CDATA[INFORME DE RECEPCIONES POR FECHAS]]></text></staticText><textField><reportElement x="0" y="70" width="600" height="18" uuid="cc621270-e64d-491a-ad37-58311bd71294"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="fb55fad0-2ab7-4d26-a5ea-9666336b4542"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" x="45" y="0" width="85" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="9d328075-aaf2-4454-a159-ca71d390fd99"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="130" y="0" width="125" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="cd6d7148-ef27-46cf-8189-2187b1764527"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Comprobante]]></text></staticText><staticText><reportElement mode="Opaque" x="255" y="0" width="300" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="90ff20e4-d454-4573-b2ed-a037a1a22c60"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Proveedor]]></text></staticText><staticText><reportElement mode="Opaque" x="555" y="0" width="120" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="fd4c039e-bb64-4e68-9136-9660ac348bb5"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText><staticText><reportElement mode="Opaque" x="675" y="0" width="127" height="26" forecolor="#FFFFFF" backcolor="#2C3E50" uuid="eb09b7af-d345-44a5-9d28-0084100c6ec1"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText></band></columnHeader>
	<detail><band height="20"><textField><reportElement x="0" y="0" width="45" height="20" uuid="b48a2a64-e0f6-4ac7-b7b9-4df9cdf5331c"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_recepcion}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="45" y="0" width="85" height="20" uuid="f9708387-b4c4-41fb-99ed-65f83df403c4"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_recepcion}]]></textFieldExpression></textField><textField><reportElement x="130" y="0" width="125" height="20" uuid="d8ffa344-15b9-417f-8b50-b5fe9358baee"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{comprobante}]]></textFieldExpression></textField><textField><reportElement x="255" y="0" width="300" height="20" uuid="f79cf3d7-df4e-4243-8705-e2772fdc80c6"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField><textField><reportElement x="555" y="0" width="120" height="20" uuid="49680b53-30a9-43ed-92d6-a6edc9cc3921"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField><textField><reportElement x="675" y="0" width="127" height="20" uuid="f3a50ca5-0839-46b2-80a7-a1f1b39dcdbe"/><box><pen lineWidth="0.5" lineColor="#DCDCDC"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField></band></detail>
