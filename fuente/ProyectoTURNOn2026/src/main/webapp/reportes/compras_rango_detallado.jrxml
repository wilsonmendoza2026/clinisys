<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="compras_rango_detallado" language="java" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" uuid="86d8b93a-e8b4-46ad-b8f9-9d9d4546309b">
<parameter name="MODO_GENERAL" class="java.lang.Boolean"/><parameter name="FECHA_INICIO" class="java.sql.Date"/><parameter name="FECHA_FIN" class="java.sql.Date"/><parameter name="PROVEEDOR" class="java.lang.String"/><parameter name="ESTADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT c.id_compra,c.fecha_compra,COALESCE(p.razon_social,'Sin Proveedor') AS proveedor,COALESCE(c.numero_factura,'-') AS factura,COALESCE(i.nombre_insumo,'Sin Insumo') AS insumo,d.cantidad,d.precio_unitario,(d.cantidad*d.precio_unitario)::numeric AS subtotal,COALESCE(c.estado_compra,'-') AS estado FROM compras c LEFT JOIN proveedores p ON c.id_proveedor=p.id_proveedor LEFT JOIN detalles_compras d ON c.id_compra=d.id_compra LEFT JOIN insumos i ON d.id_insumo=i.id_insumo WHERE ($P{MODO_GENERAL} = TRUE OR c.fecha_compra BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}) AND ($P{ESTADO} IS NULL OR UPPER(c.estado_compra) = UPPER($P{ESTADO})) AND ($P{PROVEEDOR} IS NULL OR p.razon_social ILIKE '%' || $P{PROVEEDOR} || '%') ORDER BY c.fecha_compra,c.id_compra,i.nombre_insumo]]></queryString>
<field name="id_compra" class="java.lang.Integer"/>
<field name="fecha_compra" class="java.sql.Date"/>
<field name="proveedor" class="java.lang.String"/>
<field name="factura" class="java.lang.String"/>
<field name="insumo" class="java.lang.String"/>
<field name="cantidad" class="java.lang.Integer"/>
<field name="precio_unitario" class="java.math.BigDecimal"/>
<field name="subtotal" class="java.math.BigDecimal"/>
<field name="estado" class="java.lang.String"/>
<variable name="sum_subtotal" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
<group name="Grupo_id_compra"><groupExpression><![CDATA[$F{id_compra}]]></groupExpression><groupHeader><band height="18"><staticText><reportElement x="0" y="0" width="802" height="18" uuid="d4abccec-7201-447c-bd6d-e066db0a6e39"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Detalle agrupado por registro]]></text></staticText></band></groupHeader></group>
<title><band height="92"><rectangle radius="5"><reportElement x="0" y="0" width="802" height="65" backcolor="#006B45" uuid="ffd9523c-bcce-48c3-bb78-87249b8b5309"/></rectangle><staticText><reportElement x="0" y="6" width="802" height="30" forecolor="#FFFFFF" uuid="f90daa90-61cc-40cd-a645-ace4f4e55b3d"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement><text><![CDATA[ClinicSys]]></text></staticText><staticText><reportElement x="0" y="38" width="802" height="20" forecolor="#FFFFFF" uuid="3aa464d1-fe3b-4c4d-88a5-59a8d7c8df5b"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="10"/></textElement><text><![CDATA[INFORME DETALLADO DE COMPRAS]]></text></staticText><textField><reportElement x="0" y="70" width="650" height="18" uuid="c04c9c18-74df-418d-b558-31d5e91aa9f5"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN})]]></textFieldExpression></textField></band></title>
<columnHeader><band height="26"><staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="ee684911-2410-4bd9-84bb-c28d757062cd"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Compra]]></text></staticText><staticText><reportElement mode="Opaque" x="45" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="e3f913d6-aadb-43d4-8165-2b956f7456c6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement mode="Opaque" x="115" y="0" width="180" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="cacd3532-29e3-439e-9a38-2dc61797817b"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Proveedor]]></text></staticText><staticText><reportElement mode="Opaque" x="295" y="0" width="100" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="fb4b67c8-d97a-414a-bed6-6d8a8b6b72d0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Factura]]></text></staticText><staticText><reportElement mode="Opaque" x="395" y="0" width="190" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="732d8145-8b47-40c9-9302-6dcaacfbf277"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Insumo]]></text></staticText><staticText><reportElement mode="Opaque" x="585" y="0" width="45" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="684f2f28-045f-4a17-8ef2-1f604074e2d5"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Cant.]]></text></staticText><staticText><reportElement mode="Opaque" x="630" y="0" width="80" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="77a8f15d-e66a-4187-ad61-a1b1da4c3440"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Precio]]></text></staticText><staticText><reportElement mode="Opaque" x="710" y="0" width="85" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="c01322a8-b17e-40f9-80de-201679668278"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Subtotal]]></text></staticText><staticText><reportElement mode="Opaque" x="795" y="0" width="107" height="26" forecolor="#FFFFFF" backcolor="#253B56" uuid="3d0b22ff-3a38-477d-b7c3-01b301ee2735"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
<detail><band height="26"><textField><reportElement x="0" y="0" width="45" height="26" uuid="27c4dbdb-5393-4eae-a10e-77c4cfc8788d"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{id_compra}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="45" y="0" width="70" height="26" uuid="77f9751e-b1d0-45f4-942f-4ba481a98096"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha_compra}]]></textFieldExpression></textField><textField><reportElement x="115" y="0" width="180" height="26" uuid="faac6ff4-2dd6-43a7-9a16-8a76a586ceae"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField><textField><reportElement x="295" y="0" width="100" height="26" uuid="bea9a6e1-d3fc-41e5-a5e3-f3ca45dc3692"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{factura}]]></textFieldExpression></textField><textField><reportElement x="395" y="0" width="190" height="26" uuid="62f56cdc-b49a-4bea-b8a4-0f522dc29406"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{insumo}]]></textFieldExpression></textField><textField><reportElement x="585" y="0" width="45" height="26" uuid="69b07f54-5a01-451b-9cb2-4403336670fc"/><box><pen lineWidth="0.5" lineColor="#D8DEE6"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>