<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="insumos_recomendados" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" uuid="fa71234b-b846-4a6c-a38a-9cfb2ddeb40f">
	<parameter name="id_diagnostico" class="java.lang.Integer"/>
	<parameter name="es_admin" class="java.lang.Boolean"/>
	<parameter name="id_medico" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT d.id_diagnostico,
       d.fecha_diagnostico,
       COALESCE(p.apellido || ', ' || p.nombre, 'Sin paciente') AS paciente,
       COALESCE(m.apellido || ', ' || m.nombre, 'Sin médico') AS medico,
       COALESCE(ir.nombre_insumo, i.nombre_insumo, 'No se recomendaron insumos') AS nombre_insumo,
       COALESCE(ir.cantidad, 1) AS cantidad,
       COALESCE(ir.indicaciones, '') AS indicaciones
FROM public.diagnosticos d
LEFT JOIN public.pacientes p ON p.id_paciente = d.id_paciente
LEFT JOIN public.medicos m ON m.id_medico = d.id_medico
LEFT JOIN public.diagnosticos_insumos_recomendados ir ON ir.id_diagnostico = d.id_diagnostico
LEFT JOIN public.insumos i ON i.id_insumo = ir.id_insumo
WHERE d.id_diagnostico = $P{id_diagnostico}
  AND ($P{es_admin} = TRUE OR d.id_medico = $P{id_medico})
ORDER BY ir.id_recomendacion]]>
	</queryString>
	<field name="id_diagnostico" class="java.lang.Integer"/>
	<field name="fecha_diagnostico" class="java.sql.Date"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="nombre_insumo" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="indicaciones" class="java.lang.String"/>
