<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@page import="java.sql.*"%>
<%@page import="java.util.*"%>
<%-- Control de sesion: sin login no se puede usar este controlador --%>
<% if (session.getAttribute("logueado") == null || "0".equals(String.valueOf(session.getAttribute("logueado")))) { response.setStatus(HttpServletResponse.SC_UNAUTHORIZED); out.print("Sesion no valida o expirada."); return; } %>
<%!
 private String e(Object v){if(v==null)return "";return String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
 private String money(ResultSet r,String c)throws SQLException{java.math.BigDecimal n=r.getBigDecimal(c);return String.format("%,.0f",n==null?0:n.doubleValue());}
 private String tipo(String s){if(s==null)return "";if(s.endsWith("_rango"))s=s.substring(0,s.length()-6);return Arrays.asList("citas","diagnosticos","internaciones","ordenes_compra","recepciones","compras","ventas").contains(s)?s:"";}
%>
<%
 String tipo=tipo(request.getParameter("tipo"));String id=request.getParameter("id");
 if(tipo.isEmpty()||id==null||!id.matches("\\d+")){out.print("<div class='alert alert-danger m-3'>Parámetros inválidos.</div>");return;}
 String sql="",titulo="Detalle",empty="No hay información detallada para este registro.";
 if("citas".equals(tipo)){titulo="Datos de la cita";sql="SELECT c.id_cita,c.fecha,c.hora,COALESCE(p.nombre||' '||p.apellido,'Sin paciente') paciente,COALESCE(p.cedula,'') cedula,COALESCE(p.telefono,'') telefono,COALESCE(m.nombre||' '||m.apellido,'Sin médico') medico,COALESCE(es.nombre_especialidad,'') especialidad,COALESCE(s.nombre_servicio,'') servicio,COALESCE(c.estado,'') estado,COALESCE(c.estado_pago,'') estado_pago FROM citas c LEFT JOIN pacientes p ON p.id_paciente=c.id_paciente LEFT JOIN medicos m ON m.id_medico=c.id_medico LEFT JOIN especialidades es ON es.id_especialidad=m.id_especialidad LEFT JOIN servicios s ON s.id_servicio=c.id_servicio WHERE c.id_cita=?";}
 else if("diagnosticos".equals(tipo)){titulo="Datos del diagnóstico";sql="SELECT d.id_diagnostico,d.fecha_diagnostico,COALESCE(p.nombre||' '||p.apellido,'Sin paciente') paciente,COALESCE(p.cedula,'') cedula,COALESCE(m.nombre||' '||m.apellido,'Sin médico') medico,COALESCE(es.nombre_especialidad,'') especialidad,COALESCE(d.concepto_cobro,'') concepto,d.descripcion FROM diagnosticos d LEFT JOIN pacientes p ON p.id_paciente=d.id_paciente LEFT JOIN medicos m ON m.id_medico=d.id_medico LEFT JOIN especialidades es ON es.id_especialidad=m.id_especialidad WHERE d.id_diagnostico=?";}
 else if("internaciones".equals(tipo)){titulo="Datos de la internación";sql="SELECT i.id_internacion,i.fecha_ingreso,i.hora_ingreso,i.hora_salida,i.cant_dias,COALESCE(p.nombre||' '||p.apellido,'Sin paciente') paciente,COALESCE(p.cedula,'') cedula,COALESCE(h.nro_habitacion,'') habitacion,COALESCE(h.tipo,'') tipo_habitacion,COALESCE(h.precio_dia,0) precio_dia,COALESCE(i.estado,'') estado,COALESCE(i.estado_pago,'') estado_pago,COALESCE(e.nombre||' '||e.apellido,'Sin enfermero') enfermero FROM internaciones i LEFT JOIN pacientes p ON p.id_paciente=i.id_paciente LEFT JOIN habitaciones h ON h.id_habitacion=i.id_habitacion LEFT JOIN enfermeria e ON e.id_enfermero=i.id_enfermero_responsable WHERE i.id_internacion=?";}
 else if("ordenes_compra".equals(tipo)){titulo="Ítems de la orden de compra";sql="SELECT d.id_insumo,i.nombre_insumo,d.cantidad,d.precio_unitario,(d.cantidad*d.precio_unitario) subtotal FROM detalles_ordenes_compras d LEFT JOIN insumos i ON i.id_insumo=d.id_insumo WHERE d.id_orden=? ORDER BY i.nombre_insumo";}
 else if("recepciones".equals(tipo)){titulo="Ítems de la recepción";sql="SELECT dr.id_detalle,dr.id_insumo,i.nombre_insumo,dr.cantidad,dr.costo_unitario,(dr.cantidad*dr.costo_unitario) subtotal FROM detalles_recepciones dr LEFT JOIN insumos i ON i.id_insumo=dr.id_insumo WHERE dr.id_recepcion=? ORDER BY i.nombre_insumo";}
 else if("compras".equals(tipo)){titulo="Ítems de la compra";sql="SELECT d.id_insumo,i.nombre_insumo,d.cantidad,d.precio_unitario,(d.cantidad*d.precio_unitario) subtotal FROM detalles_compras d LEFT JOIN insumos i ON i.id_insumo=d.id_insumo WHERE d.id_compra=? ORDER BY i.nombre_insumo";}
 else {titulo="Conceptos de la venta / factura";sql="SELECT vd.tipo_item,CASE WHEN vd.tipo_item='INSUMO' THEN COALESCE(i.nombre_insumo,'Insumo') WHEN vd.tipo_item='SERVICIO' THEN COALESCE(s.nombre_servicio,'Servicio') WHEN vd.tipo_item='INTERNACION' THEN ('Internación Nro: '||i2.id_internacion||' - Habitación '||COALESCE(h.nro_habitacion,'')) ELSE 'Concepto' END descripcion,vd.cantidad,vd.precio_unitario,(vd.cantidad*vd.precio_unitario) subtotal,vd.tipo_iva FROM ventas_detalle vd LEFT JOIN insumos i ON vd.tipo_item='INSUMO' AND vd.id_insumo=i.id_insumo LEFT JOIN citas c ON vd.tipo_item='SERVICIO' AND vd.id_insumo=c.id_cita LEFT JOIN servicios s ON c.id_servicio=s.id_servicio LEFT JOIN internaciones i2 ON vd.tipo_item='INTERNACION' AND vd.id_insumo=i2.id_internacion LEFT JOIN habitaciones h ON i2.id_habitacion=h.id_habitacion WHERE vd.id_venta=? ORDER BY vd.tipo_item,descripcion";}
 try(Connection cn=DriverManager.getConnection("jdbc:postgresql://localhost:5432/sistema_nutricion","postgres","1");PreparedStatement ps=cn.prepareStatement(sql)){ps.setInt(1,Integer.parseInt(id));try(ResultSet rs=ps.executeQuery()){
   if(!rs.next()){out.print("<div class='alert alert-info m-3'>"+empty+"</div>");return;}
   if("citas".equals(tipo)){out.print("<div class='p-3'><table class='table table-bordered table-sm mb-0'>");String[][] a={{"Código","id_cita"},{"Fecha","fecha"},{"Hora","hora"},{"Paciente","paciente"},{"Cédula","cedula"},{"Teléfono","telefono"},{"Médico","medico"},{"Especialidad","especialidad"},{"Servicio","servicio"},{"Estado","estado"},{"Estado de pago","estado_pago"}};for(String[] x:a)out.print("<tr><th class='w-25 bg-light'>"+x[0]+"</th><td>"+e(rs.getString(x[1]))+"</td></tr>");out.print("</table></div>");}
   else if("diagnosticos".equals(tipo)){out.print("<div class='p-3'><table class='table table-bordered table-sm mb-0'>");String[][] a={{"Código","id_diagnostico"},{"Fecha","fecha_diagnostico"},{"Paciente","paciente"},{"Cédula","cedula"},{"Médico","medico"},{"Especialidad","especialidad"},{"Concepto de cobro","concepto"},{"Descripción","descripcion"}};for(String[] x:a)out.print("<tr><th class='w-25 bg-light'>"+x[0]+"</th><td>"+e(rs.getString(x[1]))+"</td></tr>");out.print("</table></div>");}
   else if("internaciones".equals(tipo)){out.print("<div class='p-3'><table class='table table-bordered table-sm mb-0'>");String[][] a={{"Código","id_internacion"},{"Ingreso","fecha_ingreso"},{"Hora de ingreso","hora_ingreso"},{"Hora de salida","hora_salida"},{"Paciente","paciente"},{"Cédula","cedula"},{"Habitación","habitacion"},{"Tipo de habitación","tipo_habitacion"},{"Precio por día","precio_dia"},{"Días","cant_dias"},{"Enfermero responsable","enfermero"},{"Estado","estado"},{"Estado de pago","estado_pago"}};for(String[] x:a)out.print("<tr><th class='w-25 bg-light'>"+x[0]+"</th><td>"+("precio_dia".equals(x[1])?money(rs,x[1]):e(rs.getString(x[1])))+"</td></tr>");out.print("</table></div>");}
   else {String[] h;if("ventas".equals(tipo))h=new String[]{"Tipo","Descripción","Cantidad","Precio unitario","Subtotal","IVA"};else if("recepciones".equals(tipo))h=new String[]{"Detalle","Código insumo","Descripción","Cantidad","Costo unitario","Subtotal"};else h=new String[]{"Código insumo","Descripción","Cantidad","Precio unitario","Subtotal"};out.print("<div class='table-responsive'><table class='table table-striped table-bordered mb-0'><thead class='thead-dark'><tr>");for(String x:h)out.print("<th>"+x+"</th>");out.print("</tr></thead><tbody>");double total=0;do{out.print("<tr>");if("ventas".equals(tipo)){out.print("<td>"+e(rs.getString("tipo_item"))+"</td><td>"+e(rs.getString("descripcion"))+"</td><td>"+e(rs.getString("cantidad"))+"</td><td class='text-right'>"+money(rs,"precio_unitario")+" Gs.</td><td class='text-right'>"+money(rs,"subtotal")+" Gs.</td><td>"+e(rs.getString("tipo_iva"))+"%</td>");}else if("recepciones".equals(tipo)){out.print("<td>"+e(rs.getString("id_detalle"))+"</td><td>"+e(rs.getString("id_insumo"))+"</td><td>"+e(rs.getString("nombre_insumo"))+"</td><td>"+e(rs.getString("cantidad"))+"</td><td class='text-right'>"+money(rs,"costo_unitario")+" Gs.</td><td class='text-right'>"+money(rs,"subtotal")+" Gs.</td>");}else{out.print("<td>"+e(rs.getString("id_insumo"))+"</td><td>"+e(rs.getString("nombre_insumo"))+"</td><td>"+e(rs.getString("cantidad"))+"</td><td class='text-right'>"+money(rs,"precio_unitario")+" Gs.</td><td class='text-right'>"+money(rs,"subtotal")+" Gs.</td>");}total+=rs.getBigDecimal("subtotal")==null?0:rs.getBigDecimal("subtotal").doubleValue();out.print("</tr>");}while(rs.next());out.print("</tbody><tfoot><tr><th colspan='"+(h.length-1)+"' class='text-right'>Total</th><th class='text-right'>"+String.format("%,.0f",total)+" Gs.</th></tr></tfoot></table></div>");}
 }}catch(Exception ex){out.print("<div class='alert alert-danger m-3'>Error al consultar el detalle: "+e(ex.getMessage())+"</div>");}
%>