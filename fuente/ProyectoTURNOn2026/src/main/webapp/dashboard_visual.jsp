<%@page contentType="text/html; charset=UTF-8"%><%@page import="java.sql.*"%><%@include file="permisos.jspf"%>
<%-- Control de sesion: sin login no se puede entrar a esta pagina --%>
<% if (session.getAttribute("logueado") == null || "0".equals(String.valueOf(session.getAttribute("logueado")))) { response.sendRedirect("login.jsp"); return; } %>
<%
String ini=request.getParameter("fecha_inicio"); String fin=request.getParameter("fecha_fin");
if(ini==null||ini.isEmpty()) ini=java.time.LocalDate.now().withDayOfMonth(1).toString(); if(fin==null||fin.isEmpty()) fin=java.time.LocalDate.now().toString();
String url="jdbc:postgresql://localhost:5432/sistema_nutricion"; String user="postgres"; String pass="1"; int citas=0,diagnosticos=0,internaciones=0,stockBajo=0; double ventas=0,utilidad=0,compras=0;
try(Connection c=DriverManager.getConnection(url,user,pass); PreparedStatement ps=c.prepareStatement("SELECT (SELECT COUNT(*) FROM citas WHERE fecha BETWEEN ? AND ?),(SELECT COUNT(*) FROM diagnosticos WHERE fecha_diagnostico BETWEEN ? AND ?),(SELECT COUNT(*) FROM internaciones WHERE fecha_ingreso::date BETWEEN ? AND ?),(SELECT COALESCE(SUM(total_venta),0) FROM ventas WHERE fecha_venta BETWEEN ? AND ?),(SELECT COALESCE(SUM(utilidad_venta),0) FROM ventas WHERE fecha_venta BETWEEN ? AND ?),(SELECT COALESCE(SUM(d.cantidad*d.precio_unitario),0) FROM detalles_compras d JOIN compras x ON x.id_compra=d.id_compra WHERE x.fecha_compra BETWEEN ? AND ?),(SELECT COUNT(*) FROM insumos WHERE stock<=stock_minimo)")){for(int i=1;i<=12;i++){if(i%2==1)ps.setDate(i,java.sql.Date.valueOf(i==13?ini:ini));else ps.setDate(i,java.sql.Date.valueOf(i==14?fin:fin));}try(ResultSet r=ps.executeQuery()){if(r.next()){citas=r.getInt(1);diagnosticos=r.getInt(2);internaciones=r.getInt(3);ventas=r.getDouble(4);utilidad=r.getDouble(5);compras=r.getDouble(6);stockBajo=r.getInt(7);}}}catch(Exception e){request.setAttribute("errorDashboard",e.getMessage());}
%><!doctype html><html><head><title>Dashboard Ejecutivo</title><style>body{font-family:Arial;background:#f4f7fa;color:#243b53;margin:30px}.head{background:#123b5d;color:white;padding:24px;border-radius:12px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:20px}.card{background:white;padding:20px;border-radius:10px;box-shadow:0 2px 8px #ccd6dd}.num{font-size:28px;font-weight:bold;color:#087f5b}.bar{height:18px;background:#e6eef3;border-radius:10px}.fill{height:18px;background:#2c7a9f;border-radius:10px}.money{color:#b7791f;font-weight:bold}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}} </style></head><body><div class="head"><h1>ClinicSys | Dashboard Ejecutivo</h1><p>Período: <%=ini%> al <%=fin%></p><a style="color:white" href="informes.jsp">Volver a Informes</a></div><div class="grid"><div class="card"><b>Citas</b><div class="num"><%=citas%></div><div class="bar"><div class="fill" style="width:<%=Math.min(100,citas)%>%"></div></div></div><div class="card"><b>Diagnósticos</b><div class="num"><%=diagnosticos%></div><div class="bar"><div class="fill" style="width:<%=Math.min(100,diagnosticos)%>%"></div></div></div><div class="card"><b>Internaciones</b><div class="num"><%=internaciones%></div><div class="bar"><div class="fill" style="width:<%=Math.min(100,internaciones)%>%"></div></div></div><div class="card"><b>Stock bajo</b><div class="num"><%=stockBajo%></div></div><div class="card"><b>Ventas</b><div class="money">Gs. <%=String.format("%,.0f",ventas)%></div></div><div class="card"><b>Utilidad</b><div class="money">Gs. <%=String.format("%,.0f",utilidad)%></div></div><div class="card"><b>Compras</b><div class="money">Gs. <%=String.format("%,.0f",compras)%></div></div><div class="card"><b>Resultado</b><div class="num"><%=ventas>=compras?"Favorable":"Revisar"%></div></div></div></body></html>